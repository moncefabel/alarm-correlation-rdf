# Copy to kgqa/.env and fill in. kgqa/.env is ignored by git, never commit it.
# Any OpenAI-compatible provider works. Groq:
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_replace_with_your_key

# OpenRouter (prepaid credits, so you can never spend more than you put in).
# Same model, pinned to one serving provider so runs stay comparable; the
# reasoning effort goes in OpenRouter's own field. Then run evaluate.py with
# --model openai/gpt-oss-120b and without --reasoning-effort.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-replace_with_your_key
# LLM_EXTRA_BODY={"provider": {"order": ["groq"], "allow_fallbacks": false}, "reasoning": {"effort": "low"}}

# Claude API (prepaid credits; calls stop when the balance is empty).
# OpenAI-compatible endpoint. Recent Claude models refuse temperature 0 there:
# the client then runs them at the default temperature and says so.
# Seed and reasoning_effort are ignored by this endpoint; run without
# --reasoning-effort and keep a separate --out folder per model.
# OPENAI_BASE_URL=https://api.anthropic.com/v1/
# OPENAI_API_KEY=sk-ant-replace_with_your_key
