sup:Column_M_PASSWORD_POLICY__PROPERTY a sup:Column ;
    rdfs:label "PROPERTY column of M_PASSWORD_POLICY" ;
    sup:columnName "PROPERTY" ;
    sup:columnOf sup:View_M_PASSWORD_POLICY ;
    sup:dataType "NVARCHAR(128)" ;
    rdfs:comment "Displays the configuration property. The following describes the contents of the individual lines of the monitor view (***VALUE***), as identified by ***PROPERTY***: force_first_password_change Displays if a user is forced to change their administrator-given password before being allowed to work any further. This property is only applicable to users connecting using their SAP HANA database user name and password. last_used_passwords Displays the number of recently used passwords of a user, which they cannot reuse. maximum_invalid_connect_attempts Displays the maximum number of allowed invalid connect attempts before a user is locked out. maximum_password_lifetime Displays the number of days that a password stays valid. maximum_unused_initial_password_lifetime Displays the number of days that an unused administrator-given password stays valid. > ### Note: > In SAP HANA 1.0 SP 12 and earlier, the parameter name is `maximum_unused_initial_password_lifetime` (note the missing 'i' in 'initial'). Use of the previous spelling is supported, but it is recommended that you update your configuration to use the correct spelling. maximum_unused_productive_password_lifetime Displays the number of days that an unused user-given password stays valid. minimal_password_length Displays the minimum number of characters required by a valid password. minimum_password_lifetime Displays the minimum number of days before a user-given password can be changed by that user. password_expire_warning_time Displays that warnings about nearly expired passwords are shown at the configured number of days before expiration. password_layout Describes the kind(s) of characters that the password must consist of. password_lock_time Displays the number of minutes the user is locked out after too many invalid connect attempts." .

sup:Column_M_PASSWORD_POLICY__VALUE a sup:Column ;
    rdfs:label "VALUE column of M_PASSWORD_POLICY" ;
    sup:columnName "VALUE" ;
