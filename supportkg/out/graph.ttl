sup:Column_M_DEBUG_SESSIONS__COMPILE_MODE a sup:Column ;
    rdfs:label "COMPILE_MODE column of M_DEBUG_SESSIONS" ;
    sup:columnName "COMPILE_MODE" ;
    sup:columnOf sup:View_M_DEBUG_SESSIONS ;
