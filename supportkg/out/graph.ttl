    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "NCLOB" ;
    rdfs:comment "Displays the relevant base table name list accessed in the plan. The format is ( ) for a list entry, with entries separated by commas." .

