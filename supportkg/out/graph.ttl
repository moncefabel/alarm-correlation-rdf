sup:Column_M_CS_ALL_COLUMNS__MAIN_PERSISTENT_MEMORY_SIZE_IN_MISC a sup:Column ;
    rdfs:label "MAIN_PERSISTENT_MEMORY_SIZE_IN_MISC column of M_CS_ALL_COLUMNS" ;
