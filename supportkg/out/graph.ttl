    rdfs:label "PORT column of M_JOB_PROGRESS" ;
    sup:columnName "PORT" ;
    sup:columnOf sup:View_M_JOB_PROGRESS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal port." .

sup:Column_M_JOB_PROGRESS__PROGRESS_DETAIL a sup:Column ;
    rdfs:label "PROGRESS_DETAIL column of M_JOB_PROGRESS" ;
    sup:columnName "PROGRESS_DETAIL" ;
    sup:columnOf sup:View_M_JOB_PROGRESS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the detailed information about the operation." .

sup:Column_M_JOB_PROGRESS__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of M_JOB_PROGRESS" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_M_JOB_PROGRESS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema of the object." .

sup:Column_M_JOB_PROGRESS__START_TIME a sup:Column ;
    rdfs:label "START_TIME column of M_JOB_PROGRESS" ;
    sup:columnName "START_TIME" ;
    sup:columnOf sup:View_M_JOB_PROGRESS ;
    sup:dataType "TIMESTAMP" ;
