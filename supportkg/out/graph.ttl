sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__FAILOVER_ACTUAL_GROUP a sup:Column ;
    rdfs:label "FAILOVER_ACTUAL_GROUP column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "FAILOVER_ACTUAL_GROUP" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the actual failover group." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__FAILOVER_CONFIG_GROUP a sup:Column ;
    rdfs:label "FAILOVER_CONFIG_GROUP column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "FAILOVER_CONFIG_GROUP" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the configured failover group. Hosts can be grouped and during failover a host is looked for within the same group. If no host is available in the same group, hosts from other groups are used." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__FAILOVER_STATUS a sup:Column ;
    rdfs:label "FAILOVER_STATUS column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "FAILOVER_STATUS" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(128)" ;
    rdfs:comment "Displays the failover status: (empty value) No failover is pending or active. waiting .. sec A failure is detected. Waiting is required to prevent an unnecessary failover. A restart of another host does not trigger an immediate failover. waiting A failure is detected. Waiting for another starting host. failover to 'host' Failover to an active host named 'host'. failback to 'host' Failback to worker host active. This happens when a standby host was assigned and is stopped. There is no automatic failback while the standby host is assigned because this would cause downtime. failed The failover failed. See `nameserver.trc` for details" .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__HOST a sup:Column ;
    rdfs:label "HOST column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "HOST" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(64)" ;
    rdfs:comment "Displays the host name." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__HOST_ACTIVE a sup:Column ;
    rdfs:label "HOST_ACTIVE column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "HOST_ACTIVE" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(128)" ;
    rdfs:comment "Displays the host active status which is a summary of the active values of all the services on that host." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__HOST_ACTUAL_ROLES a sup:Column ;
    rdfs:label "HOST_ACTUAL_ROLES column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "HOST_ACTUAL_ROLES" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(64)" ;
    rdfs:comment "Displays the host's current database and SAP HANA option roles: ETS_WORKER, ETS_STANDBY, STANDBY, STREAMING, WORKER, XS_WORKER, or XS_STANDBY." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__HOST_CONFIG_ROLES a sup:Column ;
    rdfs:label "HOST_CONFIG_ROLES column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "HOST_CONFIG_ROLES" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(64)" ;
    rdfs:comment "Displays the host's configured database and SAP HANA option roles: ETS_WORKER, ETS_STANDBY, STANDBY, STREAMING, WORKER, XS_WORKER, or XS_STANDBY." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__HOST_STATUS a sup:Column ;
    rdfs:label "HOST_STATUS column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "HOST_STATUS" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(128)" ;
    rdfs:comment "Displays the host status: OK The host is operational; the host actual role equals the configured role. IGNORE The host is operational; the host configured as standby is available, but not used. INFO The host is operational; the host actual role is different from the configured role. WARNING The host is not operational; the host should become operational after startup/failover. ERROR The host not operational; the host is in an erroneous state." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__INDEXSERVER_ACTUAL_ROLE a sup:Column ;
    rdfs:label "INDEXSERVER_ACTUAL_ROLE column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "INDEXSERVER_ACTUAL_ROLE" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the indexserver roles: COORDINATOR, WORKER, or STANDBY. Exactly one host is coordinator and all others are worker or STANDBY." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__INDEXSERVER_CONFIG_ROLE a sup:Column ;
    rdfs:label "INDEXSERVER_CONFIG_ROLE column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "INDEXSERVER_CONFIG_ROLE" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the indexserver configured roles: WORKER/STANDBY. During SAP HANA system installation or host addition, hosts can be assigned the SAP HANA server roles WORKER or STANDBY. The host can also be assigned other roles." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__NAMESERVER_ACTUAL_ROLE a sup:Column ;
    rdfs:label "NAMESERVER_ACTUAL_ROLE column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "NAMESERVER_ACTUAL_ROLE" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the nameserver actual roles: COORDINATOR/WORKER. Exactly one of the candidates is coordinator and all others are worker. The primary name server and primary index server are both on the same host." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__NAMESERVER_CONFIG_ROLE a sup:Column ;
    rdfs:label "NAMESERVER_CONFIG_ROLE column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "NAMESERVER_CONFIG_ROLE" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the nameserver configured roles: COORDINATOR/WORKER. During installation, up to 3 hosts are automatically configured as coordinator candidates. All others are worker." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__REMOVE_STATUS a sup:Column ;
