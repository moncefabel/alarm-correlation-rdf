sup:Column_DATA_TYPES__CASE_SENSITIVE a sup:Column ;
    rdfs:label "CASE_SENSITIVE column of DATA_TYPES" ;
    sup:columnName "CASE_SENSITIVE" ;
    sup:columnOf sup:View_DATA_TYPES ;
    sup:dataType "TINYINT" ;
    rdfs:comment "Displays the ODBC 2.0 SQLGetTypeInfo SMALLINT. Whether a character data type is case-sensitive in collations and comparisons." .

sup:Column_DATA_TYPES__COLUMN_SIZE a sup:Column ;
    rdfs:label "COLUMN_SIZE column of DATA_TYPES" ;
    sup:columnName "COLUMN_SIZE" ;
