    rdfs:label "TABLE_OID column of TABLE_COLUMNS" ;
    sup:columnName "TABLE_OID" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the object ID of the table." .

