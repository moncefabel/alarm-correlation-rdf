sup:Column_M_TABLE_LOB_STATISTICS__BINARY_SIZE a sup:Column ;
    rdfs:label "BINARY_SIZE column of M_TABLE_LOB_STATISTICS" ;
    sup:columnName "BINARY_SIZE" ;
    sup:columnOf sup:View_M_TABLE_LOB_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the binary size in bytes of the LOBs. This value may be less than the DISK_SIZE due to management information and paging." .

sup:Column_M_TABLE_LOB_STATISTICS__CHARACTER_SIZE a sup:Column ;
    rdfs:label "CHARACTER_SIZE column of M_TABLE_LOB_STATISTICS" ;
    sup:columnName "CHARACTER_SIZE" ;
    sup:columnOf sup:View_M_TABLE_LOB_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the number of characters in the NCLOBs (only) column. For packed LOBs, this corresponds to the total number of characters of all of the LOBs in the container." .

sup:Column_M_TABLE_LOB_STATISTICS__COLUMN_NAME a sup:Column ;
    rdfs:label "COLUMN_NAME column of M_TABLE_LOB_STATISTICS" ;
    sup:columnName "COLUMN_NAME" ;
