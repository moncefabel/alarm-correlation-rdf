sup:Column_M_CS_TABLES__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of M_CS_TABLES" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Returns the table partition ID: - For partitioned tables, the part ID is equal to the sequential number of the partition, starting at 1. - For replicated tables, the part ID is 1 for the original table and subsequent part IDs are assigned to replica tables. - The part ID is 0 for tables that are not partitioned. - A part ID value of -1 indicates that a modification of the table schema is currently in progress." .

sup:Column_M_CS_TABLES__PERSISTENT_MEMORY a sup:Column ;
    rdfs:label "PERSISTENT_MEMORY column of M_CS_TABLES" ;
    sup:columnName "PERSISTENT_MEMORY" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays the persistent memory preference inferred from user-specified preferences in bottom-up manner starting from this object: TRUE/FALSE." .

sup:Column_M_CS_TABLES__PERSISTENT_MEMORY_SIZE_IN_TOTAL a sup:Column ;
    rdfs:label "PERSISTENT_MEMORY_SIZE_IN_TOTAL column of M_CS_TABLES" ;
    sup:columnName "PERSISTENT_MEMORY_SIZE_IN_TOTAL" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "For columns stored in persistent memory, displays the total memory size in bytes." .

sup:Column_M_CS_TABLES__PERSISTENT_MERGE a sup:Column ;
    rdfs:label "PERSISTENT_MERGE column of M_CS_TABLES" ;
    sup:columnName "PERSISTENT_MERGE" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Indicates whether the new main part will be written to the disk during a table delta merge, unless requested differently: TRUE/FALSE." .

sup:Column_M_CS_TABLES__PORT a sup:Column ;
    rdfs:label "PORT column of M_CS_TABLES" ;
    sup:columnName "PORT" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal port." .

sup:Column_M_CS_TABLES__RAW_RECORD_COUNT_IN_DELTA a sup:Column ;
    rdfs:label "RAW_RECORD_COUNT_IN_DELTA column of M_CS_TABLES" ;
    sup:columnName "RAW_RECORD_COUNT_IN_DELTA" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the current number of entries in the table delta part. This value differs from the number of visible table delta rows because there are additional entries, such as deleted rows or updated rows. This column can contain deleted records." .

sup:Column_M_CS_TABLES__RAW_RECORD_COUNT_IN_MAIN a sup:Column ;
    rdfs:label "RAW_RECORD_COUNT_IN_MAIN column of M_CS_TABLES" ;
    sup:columnName "RAW_RECORD_COUNT_IN_MAIN" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the current number of entries in the main part of the table. This value differs from the number of visible table main rows because there are entries for modified rows that are marked as invalidated." .

sup:Column_M_CS_TABLES__READ_COUNT a sup:Column ;
    rdfs:label "READ_COUNT column of M_CS_TABLES" ;
    sup:columnName "READ_COUNT" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the number of read accesses on the table or partition. This is not the number of SELECT statements against this table. A SELECT statement may involve several read accesses." .

sup:Column_M_CS_TABLES__RECORD_COUNT a sup:Column ;
    rdfs:label "RECORD_COUNT column of M_CS_TABLES" ;
    sup:columnName "RECORD_COUNT" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the record count." .

sup:Column_M_CS_TABLES__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of M_CS_TABLES" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name." .

sup:Column_M_CS_TABLES__TABLE_NAME a sup:Column ;
    rdfs:label "TABLE_NAME column of M_CS_TABLES" ;
    sup:columnName "TABLE_NAME" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the table name." .

sup:Column_M_CS_TABLES__UNUSED_RETENTION_PERIOD a sup:Column ;
    rdfs:label "UNUSED_RETENTION_PERIOD column of M_CS_TABLES" ;
    sup:columnName "UNUSED_RETENTION_PERIOD" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the unused retention period." .

sup:Column_M_CS_TABLES__WRITE_COUNT a sup:Column ;
    rdfs:label "WRITE_COUNT column of M_CS_TABLES" ;
    sup:columnName "WRITE_COUNT" ;
    sup:columnOf sup:View_M_CS_TABLES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the number of write accesses on the table or partition. This is not the number of DML and DDL statements against this table. A DML or DDL statement may involve several write accesses." .

sup:Column_M_CS_TABLE_HANDLES__ACQUIRE_TIME a sup:Column ;
    rdfs:label "ACQUIRE_TIME column of M_CS_TABLE_HANDLES" ;
    sup:columnName "ACQUIRE_TIME" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the timestamp value for the acquired time." .

sup:Column_M_CS_TABLE_HANDLES__CURRENT_STATE a sup:Column ;
    rdfs:label "CURRENT_STATE column of M_CS_TABLE_HANDLES" ;
    sup:columnName "CURRENT_STATE" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "VARCHAR(30)" ;
    rdfs:comment "Displays the current state of the IndexHandle. Values are: search_delta, finish_delta_merge, delete., etc. It is the lowercase state name with the prefix ns_ removed." .

sup:Column_M_CS_TABLE_HANDLES__HANDLE_ID a sup:Column ;
    rdfs:label "HANDLE_ID column of M_CS_TABLE_HANDLES" ;
    sup:columnName "HANDLE_ID" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "VARCHAR(20)" ;
    rdfs:comment "Displays the unique memory address of the IndexHandle." .

sup:Column_M_CS_TABLE_HANDLES__INITIAL_ACQUIRE_TIME a sup:Column ;
    rdfs:label "INITIAL_ACQUIRE_TIME column of M_CS_TABLE_HANDLES" ;
    sup:columnName "INITIAL_ACQUIRE_TIME" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the timestamp value when IndexHandles are upgraded or downgraded to different states. This preserves the time when the IndexHandle was first acquired along with the table name." .

sup:Column_M_CS_TABLE_HANDLES__INTERNAL_PART_ID a sup:Column ;
    rdfs:label "INTERNAL_PART_ID column of M_CS_TABLE_HANDLES" ;
    sup:columnName "INTERNAL_PART_ID" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal partition number as used in internal IndexName objects." .

sup:Column_M_CS_TABLE_HANDLES__LOCK_ID a sup:Column ;
    rdfs:label "LOCK_ID column of M_CS_TABLE_HANDLES" ;
    sup:columnName "LOCK_ID" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "VARCHAR(20)" ;
    rdfs:comment "Displays the unique identifier for the table at IndexMgr level, also found in dumps, trace output, etc." .

sup:Column_M_CS_TABLE_HANDLES__NEXT_STATE a sup:Column ;
    rdfs:label "NEXT_STATE column of M_CS_TABLE_HANDLES" ;
    sup:columnName "NEXT_STATE" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "VARCHAR(30)" ;
    rdfs:comment "Displays the next state of the IndexHandle when waiting for a lock upgrade. Values are the same as for CURRENT_STATE." .

sup:Column_M_CS_TABLE_HANDLES__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of M_CS_TABLE_HANDLES" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the logical partition number, 0 if the table is not partitioned, -1 if the logical partition number may not be retrieved from metadata." .

sup:Column_M_CS_TABLE_HANDLES__QUEUE_POSITION a sup:Column ;
    rdfs:label "QUEUE_POSITION column of M_CS_TABLE_HANDLES" ;
    sup:columnName "QUEUE_POSITION" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the position within the queue, when waiting; otherwise the value is 0." .

sup:Column_M_CS_TABLE_HANDLES__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of M_CS_TABLE_HANDLES" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name as used in SQL." .

sup:Column_M_CS_TABLE_HANDLES__TABLE_NAME a sup:Column ;
    rdfs:label "TABLE_NAME column of M_CS_TABLE_HANDLES" ;
    sup:columnName "TABLE_NAME" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the table name as used in SQL." .

sup:Column_M_CS_TABLE_HANDLES__TABLE_OID a sup:Column ;
    rdfs:label "TABLE_OID column of M_CS_TABLE_HANDLES" ;
    sup:columnName "TABLE_OID" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the unique internal table ID which remains unchanged during rename." .

sup:Column_M_CS_TABLE_HANDLES__THREAD_ID a sup:Column ;
    rdfs:label "THREAD_ID column of M_CS_TABLE_HANDLES" ;
    sup:columnName "THREAD_ID" ;
    sup:columnOf sup:View_M_CS_TABLE_HANDLES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the thread using the IndexHandle (when it was acquired)." .

sup:Column_M_CS_TABLE_LOCKS__ACQUIRED_HANDLE_COUNT a sup:Column ;
    rdfs:label "ACQUIRED_HANDLE_COUNT column of M_CS_TABLE_LOCKS" ;
    sup:columnName "ACQUIRED_HANDLE_COUNT" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of handles acquired for the table." .

sup:Column_M_CS_TABLE_LOCKS__INTERNAL_PART_ID a sup:Column ;
    rdfs:label "INTERNAL_PART_ID column of M_CS_TABLE_LOCKS" ;
    sup:columnName "INTERNAL_PART_ID" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal partition number as used in internal IndexName objects." .

sup:Column_M_CS_TABLE_LOCKS__IS_BLOCK_MAIN a sup:Column ;
    rdfs:label "IS_BLOCK_MAIN column of M_CS_TABLE_LOCKS" ;
    sup:columnName "IS_BLOCK_MAIN" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "VARCHAR(5)" ;
    rdfs:comment "Displays the iternal flag used for asserting in IndexMgr code." .

sup:Column_M_CS_TABLE_LOCKS__IS_COORDINATOR a sup:Column ;
    rdfs:label "IS_COORDINATOR column of M_CS_TABLE_LOCKS" ;
    sup:columnName "IS_COORDINATOR" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "VARCHAR(5)" ;
    rdfs:comment "Displays the internal flag used for asserting in IndexMgr code." .

sup:Column_M_CS_TABLE_LOCKS__IS_MODE_NO_WAIT a sup:Column ;
    rdfs:label "IS_MODE_NO_WAIT column of M_CS_TABLE_LOCKS" ;
    sup:columnName "IS_MODE_NO_WAIT" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "VARCHAR(5)" ;
    rdfs:comment "Displays the IS_MODE_NO_WAIT flag. Access to all current handles is granted without waiting in an optimized per thread structure since none of the active handles are in conflict. This internal flag is automatically set and reset during locking operations to trigger internal performance optimizations, it does not relate to the NOWAIT keyword of SQL." .

sup:Column_M_CS_TABLE_LOCKS__IS_SHARED a sup:Column ;
    rdfs:label "IS_SHARED column of M_CS_TABLE_LOCKS" ;
    sup:columnName "IS_SHARED" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "VARCHAR(5)" ;
    rdfs:comment "Displays the internal flag used for asserting in IndexMgr code." .

sup:Column_M_CS_TABLE_LOCKS__IS_TABLE a sup:Column ;
    rdfs:label "IS_TABLE column of M_CS_TABLE_LOCKS" ;
    sup:columnName "IS_TABLE" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "VARCHAR(5)" ;
    rdfs:comment "Displays the internal flag used for asserting in IndexMgr code." .

sup:Column_M_CS_TABLE_LOCKS__LOCK_ID a sup:Column ;
    rdfs:label "LOCK_ID column of M_CS_TABLE_LOCKS" ;
    sup:columnName "LOCK_ID" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "VARCHAR(20)" ;
    rdfs:comment "Displays the unique identifier for the table at IndexMgr level, also found in dumps, trace output, etc." .

sup:Column_M_CS_TABLE_LOCKS__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of M_CS_TABLE_LOCKS" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the logical partition number, 0 if the table is not partitioned, -1 if the logical partition number cannot be retrieved from metadata." .

sup:Column_M_CS_TABLE_LOCKS__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of M_CS_TABLE_LOCKS" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name as used in SQL." .

sup:Column_M_CS_TABLE_LOCKS__TABLE_NAME a sup:Column ;
    rdfs:label "TABLE_NAME column of M_CS_TABLE_LOCKS" ;
    sup:columnName "TABLE_NAME" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the table name as used in SQL." .

sup:Column_M_CS_TABLE_LOCKS__TABLE_OID a sup:Column ;
    rdfs:label "TABLE_OID column of M_CS_TABLE_LOCKS" ;
    sup:columnName "TABLE_OID" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the unique internal table ID, which remains unchanged during rename." .

sup:Column_M_CS_TABLE_LOCKS__WAITING_HANDLE_COUNT a sup:Column ;
    rdfs:label "WAITING_HANDLE_COUNT column of M_CS_TABLE_LOCKS" ;
    sup:columnName "WAITING_HANDLE_COUNT" ;
    sup:columnOf sup:View_M_CS_TABLE_LOCKS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of handles waiting for access to the table." .

sup:Column_M_CS_UNLOADS__COLUMN_NAME a sup:Column ;
    rdfs:label "COLUMN_NAME column of M_CS_UNLOADS" ;
    sup:columnName "COLUMN_NAME" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the column name. Empty if the whole table is unloaded." .

sup:Column_M_CS_UNLOADS__HOST a sup:Column ;
    rdfs:label "HOST column of M_CS_UNLOADS" ;
    sup:columnName "HOST" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "NVARCHAR(64)" ;
    rdfs:comment "Displays the host name." .

sup:Column_M_CS_UNLOADS__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of M_CS_UNLOADS" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the partition ID. Returns the following: - For partitioned tables, the part ID is equal to the sequential number of the partition, starting at 1. - In the case of replicated tables, the part ID is 1 for the original table and subsequent part IDs are assigned to replica tables. - The part ID is 0 for tables that are not partitioned. - A part ID value of -1 indicates that a modification of the table schema is in progress." .

sup:Column_M_CS_UNLOADS__PERSISTENT_MEMORY a sup:Column ;
    rdfs:label "PERSISTENT_MEMORY column of M_CS_UNLOADS" ;
    sup:columnName "PERSISTENT_MEMORY" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "NVARCHAR(6)" ;
    rdfs:comment "Displays whether persistent memory is removed as part of the unload. Values are RETAIN or DELETE. Empty if the user did not specify a value for the unload." .

sup:Column_M_CS_UNLOADS__PORT a sup:Column ;
    rdfs:label "PORT column of M_CS_UNLOADS" ;
    sup:columnName "PORT" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal port." .

sup:Column_M_CS_UNLOADS__REASON a sup:Column ;
    rdfs:label "REASON column of M_CS_UNLOADS" ;
    sup:columnName "REASON" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the possible reasons for the unload. Values are LOW MEMORY, SHRINK, EXPLICIT, MERGE, or UNUSED RESOURCE. Unloads caused by a manual shrink are reported as SHRINK, whereas unloads caused by memory management's automatic shrink on out of memory (OOM) are reported as LOW MEMORY." .

sup:Column_M_CS_UNLOADS__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of M_CS_UNLOADS" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name." .

sup:Column_M_CS_UNLOADS__TABLE_NAME a sup:Column ;
    rdfs:label "TABLE_NAME column of M_CS_UNLOADS" ;
    sup:columnName "TABLE_NAME" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the table name." .

sup:Column_M_CS_UNLOADS__TABLE_OID a sup:Column ;
    rdfs:label "TABLE_OID column of M_CS_UNLOADS" ;
    sup:columnName "TABLE_OID" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the object ID of the table." .

sup:Column_M_CS_UNLOADS__UNLOAD_TIME a sup:Column ;
    rdfs:label "UNLOAD_TIME column of M_CS_UNLOADS" ;
    sup:columnName "UNLOAD_TIME" ;
    sup:columnOf sup:View_M_CS_UNLOADS ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the timestamp of unload event." .

sup:Column_M_CUSTOMIZABLE_FUNCTIONALITIES__DESCRIPTION a sup:Column ;
    rdfs:label "DESCRIPTION column of M_CUSTOMIZABLE_FUNCTIONALITIES" ;
    sup:columnName "DESCRIPTION" ;
    sup:columnOf sup:View_M_CUSTOMIZABLE_FUNCTIONALITIES ;
    sup:dataType "NVARCHAR (256)" ;
    rdfs:comment "Displays the customizable functionality description." .

sup:Column_M_CUSTOMIZABLE_FUNCTIONALITIES__IS_ENABLED a sup:Column ;
    rdfs:label "IS_ENABLED column of M_CUSTOMIZABLE_FUNCTIONALITIES" ;
    sup:columnName "IS_ENABLED" ;
    sup:columnOf sup:View_M_CUSTOMIZABLE_FUNCTIONALITIES ;
    sup:dataType "NVARCHAR (5)" ;
    rdfs:comment "Indicates whether the customizable functionality is enabled: TRUE/FALSE." .

sup:Column_M_CUSTOMIZABLE_FUNCTIONALITIES__NAME a sup:Column ;
    rdfs:label "NAME column of M_CUSTOMIZABLE_FUNCTIONALITIES" ;
    sup:columnName "NAME" ;
    sup:columnOf sup:View_M_CUSTOMIZABLE_FUNCTIONALITIES ;
    sup:dataType "NVARCHAR (64)" ;
    rdfs:comment "Displays the customizable functionality name." .

sup:Column_M_DATABASES__ACTIVE_STATUS a sup:Column ;
    rdfs:label "ACTIVE_STATUS column of M_DATABASES" ;
    sup:columnName "ACTIVE_STATUS" ;
    sup:columnOf sup:View_M_DATABASES ;
    sup:dataType "NVARCHAR (16)" ;
    rdfs:comment "Displays the database status." .

sup:Column_M_DATABASES__ACTIVE_STATUS_DETAILS a sup:Column ;
    rdfs:label "ACTIVE_STATUS_DETAILS column of M_DATABASES" ;
    sup:columnName "ACTIVE_STATUS_DETAILS" ;
    sup:columnOf sup:View_M_DATABASES ;
    sup:dataType "NVARCHAR (128)" ;
    rdfs:comment "Displays the database status details. Possible values include: stopped by user, stopped due to broken recovery, or stopped by takeover." .

sup:Column_M_DATABASES__DATABASE_NAME a sup:Column ;
    rdfs:label "DATABASE_NAME column of M_DATABASES" ;
    sup:columnName "DATABASE_NAME" ;
    sup:columnOf sup:View_M_DATABASES ;
    sup:dataType "NVARCHAR (256)" ;
    rdfs:comment "Displays the database name." .

sup:Column_M_DATABASES__DESCRIPTION a sup:Column ;
    rdfs:label "DESCRIPTION column of M_DATABASES" ;
    sup:columnName "DESCRIPTION" ;
    sup:columnOf sup:View_M_DATABASES ;
    sup:dataType "NVARCHAR (2000)" ;
    rdfs:comment "Displays the database description." .

sup:Column_M_DATABASES__FALLBACK_SNAPSHOT_CREATE_TIME a sup:Column ;
    rdfs:label "FALLBACK_SNAPSHOT_CREATE_TIME column of M_DATABASES" ;
    sup:columnName "FALLBACK_SNAPSHOT_CREATE_TIME" ;
    sup:columnOf sup:View_M_DATABASES ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the timestamp for when the fallback snapshot was created, or NULL if there is no fallback snapshot for the database." .

sup:Column_M_DATABASES__OS_GROUP a sup:Column ;
    rdfs:label "OS_GROUP column of M_DATABASES" ;
    sup:columnName "OS_GROUP" ;
    sup:columnOf sup:View_M_DATABASES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the database isolation operation system group." .

sup:Column_M_DATABASES__OS_USER a sup:Column ;
    rdfs:label "OS_USER column of M_DATABASES" ;
    sup:columnName "OS_USER" ;
    sup:columnOf sup:View_M_DATABASES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the database isolation operation system user." .

sup:Column_M_DATABASES__RESTART_MODE a sup:Column ;
    rdfs:label "RESTART_MODE column of M_DATABASES" ;
    sup:columnName "RESTART_MODE" ;
    sup:columnOf sup:View_M_DATABASES ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the restart behavior after a system restart. Possible values are NO (do not restart the database after a system restart) or DEFAULT (restore the database to the state it had before the system restart)." .

sup:Column_M_DATABASE_HISTORY__INSTALL_TIME a sup:Column ;
    rdfs:label "INSTALL_TIME column of M_DATABASE_HISTORY" ;
    sup:columnName "INSTALL_TIME" ;
    sup:columnOf sup:View_M_DATABASE_HISTORY ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the installation or first start time." .

sup:Column_M_DATABASE_HISTORY__VERSION a sup:Column ;
    rdfs:label "VERSION column of M_DATABASE_HISTORY" ;
    sup:columnName "VERSION" ;
    sup:columnOf sup:View_M_DATABASE_HISTORY ;
    sup:dataType "NVARCHAR(32)" ;
    rdfs:comment "Displays the version: major.minor.patch.build." .

sup:Column_M_DATABASE_REPLICAS__REPLICATION_STATUS a sup:Column ;
    rdfs:label "REPLICATION_STATUS column of M_DATABASE_REPLICAS" ;
    sup:columnName "REPLICATION_STATUS" ;
    sup:columnOf sup:View_M_DATABASE_REPLICAS ;
    sup:dataType "NVARCHAR(12)" ;
    rdfs:comment "Displays the aggregated replication status of the database services." .

sup:Column_M_DATABASE_REPLICAS__SOURCE_DATABASE_NAME a sup:Column ;
    rdfs:label "SOURCE_DATABASE_NAME column of M_DATABASE_REPLICAS" ;
    sup:columnName "SOURCE_DATABASE_NAME" ;
    sup:columnOf sup:View_M_DATABASE_REPLICAS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the name of the source database." .

sup:Column_M_DATABASE_REPLICAS__SOURCE_SYSTEMDB_HOST a sup:Column ;
    rdfs:label "SOURCE_SYSTEMDB_HOST column of M_DATABASE_REPLICAS" ;
    sup:columnName "SOURCE_SYSTEMDB_HOST" ;
    sup:columnOf sup:View_M_DATABASE_REPLICAS ;
