    rdfs:comment "Displays the compilation handling of nested procedures." .

sup:Column_M_DEBUG_SESSIONS__DEBUG_SESSION_ID a sup:Column ;
    rdfs:label "DEBUG_SESSION_ID column of M_DEBUG_SESSIONS" ;
    sup:columnName "DEBUG_SESSION_ID" ;
    sup:columnOf sup:View_M_DEBUG_SESSIONS ;
    sup:dataType "NVARCHAR(32)" ;
    rdfs:comment "Displays the landscape-wide unique identifier for debug session." .

sup:Column_M_DEBUG_SESSIONS__TIMEOUT a sup:Column ;
    rdfs:label "TIMEOUT column of M_DEBUG_SESSIONS" ;
    sup:columnName "TIMEOUT" ;
    sup:columnOf sup:View_M_DEBUG_SESSIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the time in seconds after which the debug session will timeout and destroy itself." .

sup:Column_M_DELTA_MERGE_STATISTICS__CS_ERROR a sup:Column ;
    rdfs:label "CS_ERROR column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "CS_ERROR" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the column store specific error code. See ERROR_DESCRIPTION for details." .

sup:Column_M_DELTA_MERGE_STATISTICS__ERROR_DESCRIPTION a sup:Column ;
    rdfs:label "ERROR_DESCRIPTION column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "ERROR_DESCRIPTION" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(2000)" ;
    rdfs:comment "Displays the description of the last error that occurred during the merge. A failing merge does not necessarily indicate a problem." .

sup:Column_M_DELTA_MERGE_STATISTICS__EXECUTION_TIME a sup:Column ;
    rdfs:label "EXECUTION_TIME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "EXECUTION_TIME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the execution duration in milliseconds." .

sup:Column_M_DELTA_MERGE_STATISTICS__HOST a sup:Column ;
    rdfs:label "HOST column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "HOST" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(64)" ;
    rdfs:comment "Displays the host name." .

sup:Column_M_DELTA_MERGE_STATISTICS__INTERNAL_PART_ID a sup:Column ;
    rdfs:label "INTERNAL_PART_ID column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "INTERNAL_PART_ID" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal partition ID." .

sup:Column_M_DELTA_MERGE_STATISTICS__LAST_ERROR a sup:Column ;
    rdfs:label "LAST_ERROR column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "LAST_ERROR" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the error code of the last error that occurred. This explains why a merge did not succeed. See ERROR_DESCRIPTION for details." .

sup:Column_M_DELTA_MERGE_STATISTICS__LOG_REPLAY_QUEUE_ID a sup:Column ;
    rdfs:label "LOG_REPLAY_QUEUE_ID column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "LOG_REPLAY_QUEUE_ID" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the ID of the log replay queue where the job was started. During log replay, only delta merge and optimize compression operations are possible. During online operation, all TYPEs apply. -1 indicates that online merges and optimized compressions exist." .

sup:Column_M_DELTA_MERGE_STATISTICS__MEMORY_MERGE a sup:Column ;
    rdfs:label "MEMORY_MERGE column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "MEMORY_MERGE" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Deprecated. Use the TYPE column, which displays more detailed information." .

sup:Column_M_DELTA_MERGE_STATISTICS__MERGED_DELTA_RECORDS a sup:Column ;
    rdfs:label "MERGED_DELTA_RECORDS column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "MERGED_DELTA_RECORDS" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of rows merged from old delta1 to new main for MERGE operation or the number of rows evicted from delta during RECLAIM delta operation. -1 indicates other operation types." .

sup:Column_M_DELTA_MERGE_STATISTICS__MERGED_MAIN_RECORDS a sup:Column ;
    rdfs:label "MERGED_MAIN_RECORDS column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "MERGED_MAIN_RECORDS" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of rows merged from old main to new main. -1 indicates other operation types." .

sup:Column_M_DELTA_MERGE_STATISTICS__MOTIVATION a sup:Column ;
    rdfs:label "MOTIVATION column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "MOTIVATION" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(9)" ;
    rdfs:comment "Displays the motivation of the statistics: AUTO Triggered based on an automatic decision function. SMART Triggered by a HINT from the user based on a smart decision function. CRITICAL Triggered based on a critical decision function. HARD Triggered via SQL based on a hard decision function. FORCED A merge triggered via SQL, circumventing resource availability checks, based on a forced decision function." .

sup:Column_M_DELTA_MERGE_STATISTICS__NEW_MAIN_RECORDS a sup:Column ;
    rdfs:label "NEW_MAIN_RECORDS column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "NEW_MAIN_RECORDS" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the total number of rows in new main after the merge. It is the sum of MERGED_MAIN_RECORDS and MERGED_DELTA_RECORDS. -1 indicates other operation types." .

sup:Column_M_DELTA_MERGE_STATISTICS__OLD_DELTA_IN_USE a sup:Column ;
    rdfs:label "OLD_DELTA_IN_USE column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "OLD_DELTA_IN_USE" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays TRUE when old delta1 is still in use by old readers once the merge is finished. It will only be deleted after the last reader has finished. FALSE indicates other operation types." .

sup:Column_M_DELTA_MERGE_STATISTICS__OLD_DELTA_RECORDS a sup:Column ;
    rdfs:label "OLD_DELTA_RECORDS column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "OLD_DELTA_RECORDS" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of rows merged from old main to new main. -1 indicates other operation types." .

sup:Column_M_DELTA_MERGE_STATISTICS__OLD_MAIN_IN_USE a sup:Column ;
    rdfs:label "OLD_MAIN_IN_USE column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "OLD_MAIN_IN_USE" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays TRUE when old main is still in use by old readers once the merge or optimize compression is finished. Old main will only be deleted after the last reader has finished. FALSE indicates other operation types." .

sup:Column_M_DELTA_MERGE_STATISTICS__OLD_MAIN_RECORDS a sup:Column ;
    rdfs:label "OLD_MAIN_RECORDS column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "OLD_MAIN_RECORDS" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of rows in old main prior to the delta merge. -1 indicates other operation types." .

sup:Column_M_DELTA_MERGE_STATISTICS__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the partition ID. Returns the following: - For partitioned tables, the part ID is equal to the sequential number of the partition, starting at 1. - In the case of replicated tables, the part ID is 1 for the original table and subsequent part IDs are assigned to replica tables. - The part ID is 0 for tables that are not partitioned. - A part ID value of -1 indicates that a modification of the table schema is in progress." .

sup:Column_M_DELTA_MERGE_STATISTICS__PASSPORT a sup:Column ;
    rdfs:label "PASSPORT column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "PASSPORT" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the external identifier for the table merge called by an application." .

sup:Column_M_DELTA_MERGE_STATISTICS__PHASE_1_BLOCKING_LOCK_WAIT_TIME a sup:Column ;
    rdfs:label "PHASE_1_BLOCKING_LOCK_WAIT_TIME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "PHASE_1_BLOCKING_LOCK_WAIT_TIME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the wait time in milliseconds to acquire an exclusive lock in the first exclusive merge phase in the event the hesitant acquire was unsuccessful. New readers and writers are already blocked." .

sup:Column_M_DELTA_MERGE_STATISTICS__PHASE_1_HESITANT_LOCK_WAIT_TIME a sup:Column ;
    rdfs:label "PHASE_1_HESITANT_LOCK_WAIT_TIME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "PHASE_1_HESITANT_LOCK_WAIT_TIME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the total wait time in milliseconds to acquire an exclusive lock in the first exclusive merge phase. The time includes configured timeout and subsequent retries." .

sup:Column_M_DELTA_MERGE_STATISTICS__PHASE_1_LOCK_TIME a sup:Column ;
    rdfs:label "PHASE_1_LOCK_TIME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "PHASE_1_LOCK_TIME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the time in milliseconds spent under exclusive lock in the first exclusive merge phase." .

sup:Column_M_DELTA_MERGE_STATISTICS__PHASE_2_BLOCKING_LOCK_WAIT_TIME a sup:Column ;
    rdfs:label "PHASE_2_BLOCKING_LOCK_WAIT_TIME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "PHASE_2_BLOCKING_LOCK_WAIT_TIME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the time in milliseconds to acquire an exclusive lock for the second exclusive merge phase or the exclusive optimize compression phase, respectively, in the event the hesitant acquire was unsuccessful. New readers and writers are already blocked." .

sup:Column_M_DELTA_MERGE_STATISTICS__PHASE_2_HESITANT_LOCK_WAIT_TIME a sup:Column ;
    rdfs:label "PHASE_2_HESITANT_LOCK_WAIT_TIME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "PHASE_2_HESITANT_LOCK_WAIT_TIME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the total wait time in milliseconds to acquire an exclusive lock for the second exclusive merge phase or the exclusive optimize compression phase, respectively. The time includes configured timeout and subsequent retries.\"" .

sup:Column_M_DELTA_MERGE_STATISTICS__PHASE_2_LOCK_TIME a sup:Column ;
    rdfs:label "PHASE_2_LOCK_TIME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "PHASE_2_LOCK_TIME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the time in milliseconds spent under exclusive lock in the second exclusive merge phase or the exclusive optimize compression phase, respectively." .

sup:Column_M_DELTA_MERGE_STATISTICS__PORT a sup:Column ;
    rdfs:label "PORT column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "PORT" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal port number." .

sup:Column_M_DELTA_MERGE_STATISTICS__RESOURCE_WAIT_TIME a sup:Column ;
    rdfs:label "RESOURCE_WAIT_TIME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "RESOURCE_WAIT_TIME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the total wait time in milliseconds for memory and CPU resources when too many merges or optimized compressions have been started in parallel." .

sup:Column_M_DELTA_MERGE_STATISTICS__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name." .

sup:Column_M_DELTA_MERGE_STATISTICS__START_TIME a sup:Column ;
    rdfs:label "START_TIME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "START_TIME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the execution start time." .

sup:Column_M_DELTA_MERGE_STATISTICS__SUCCESS a sup:Column ;
    rdfs:label "SUCCESS column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "SUCCESS" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays a call success flag, which depends on the field TYPE. HINT Displays whether the application merge hint was accepted or rejected. MERGE/SPARSE Displays whether the delta merge/optimize compression was completed with or without success: TRUE/FALSE. For example, a table delta merge call which did not result in a delta merge because the delta was empty, is indicated with FALSE." .

sup:Column_M_DELTA_MERGE_STATISTICS__TABLE_NAME a sup:Column ;
    rdfs:label "TABLE_NAME column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "TABLE_NAME" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the table name." .

sup:Column_M_DELTA_MERGE_STATISTICS__TABLE_OID a sup:Column ;
    rdfs:label "TABLE_OID column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "TABLE_OID" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the object ID of the table." .

sup:Column_M_DELTA_MERGE_STATISTICS__TYPE a sup:Column ;
    rdfs:label "TYPE column of M_DELTA_MERGE_STATISTICS" ;
    sup:columnName "TYPE" ;
    sup:columnOf sup:View_M_DELTA_MERGE_STATISTICS ;
    sup:dataType "NVARCHAR(8)" ;
    rdfs:comment "Displays the type of the statistic: MERGE The table delta merge. HINT The application merge hint. SPARSE Optimizes compression. FACT The fact table compression. RECLAIM The table delta garbage collection." .

