    sup:columnName "DATA_STATISTICS_TYPE" ;
    sup:columnOf sup:View_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(9)" ;
    rdfs:comment "Displays the data statistics type." .

sup:Column_DATA_STATISTICS__INVALIDATION_REASON a sup:Column ;
    rdfs:label "INVALIDATION_REASON column of DATA_STATISTICS" ;
    sup:columnName "INVALIDATION_REASON" ;
    sup:columnOf sup:View_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(32)" ;
    rdfs:comment "Displays the reason for invalidating a data statistics object: NULL The object is valid. USER ACTION The data statistics object is invalid because a user has disabled it. ALTER TABLE MOVE The data statistics object is disabled because a user relocated the table to a different storage space. ALTER COLUMN DATA TYPE The data statistics object is disabled because the data type of the underlying column(s) no longer supports the statistics type." .

sup:Column_DATA_STATISTICS__IS_ENABLED a sup:Column ;
    rdfs:label "IS_ENABLED column of DATA_STATISTICS" ;
    sup:columnName "IS_ENABLED" ;
    sup:columnOf sup:View_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether the data statistics object is enabled: TRUE/FALSE." .

sup:Column_DATA_STATISTICS__IS_PERSISTENT a sup:Column ;
    rdfs:label "IS_PERSISTENT column of DATA_STATISTICS" ;
    sup:columnName "IS_PERSISTENT" ;
    sup:columnOf sup:View_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether the content of the data statistics object is persistent or not: TRUE/FALSE." .

sup:Column_DATA_STATISTICS__VALID_FOR a sup:Column ;
    rdfs:label "VALID_FOR column of DATA_STATISTICS" ;
    sup:columnName "VALID_FOR" ;
    sup:columnOf sup:View_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(32)" ;
    rdfs:comment "Displays how the data statistics object may be used: ESTIMATION/DATA DEPENDENCY." .

