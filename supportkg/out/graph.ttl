    rdfs:comment "Displays the superblock size in bytes." .

sup:Column_M_DATA_VOLUME_SUPERBLOCK_STATISTICS__USED_SUPERBLOCK_COUNT a sup:Column ;
    rdfs:label "USED_SUPERBLOCK_COUNT column of M_DATA_VOLUME_SUPERBLOCK_STATISTICS" ;
