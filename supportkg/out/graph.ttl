sup:Column_M_JOINENGINE_STATISTICS__TRANSLATION_TABLE_UNLOAD_COUNT a sup:Column ;
    rdfs:label "TRANSLATION_TABLE_UNLOAD_COUNT column of M_JOINENGINE_STATISTICS" ;
    sup:columnName "TRANSLATION_TABLE_UNLOAD_COUNT" ;
    sup:columnOf sup:View_M_JOINENGINE_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the number of translation table unloads." .

sup:Column_M_JOIN_DATA_STATISTICS__COLUMN_NAME1 a sup:Column ;
    rdfs:label "COLUMN_NAME1 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "COLUMN_NAME1" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the column name of the first table" .

sup:Column_M_JOIN_DATA_STATISTICS__COLUMN_NAME2 a sup:Column ;
    rdfs:label "COLUMN_NAME2 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "COLUMN_NAME2" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the column name of the second table." .

sup:Column_M_JOIN_DATA_STATISTICS__COUNT1 a sup:Column ;
    rdfs:label "COUNT1 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "COUNT1" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the number of not Null values of the column of the first table." .

sup:Column_M_JOIN_DATA_STATISTICS__DISTINCT_COUNT1 a sup:Column ;
    rdfs:label "DISTINCT_COUNT1 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "DISTINCT_COUNT1" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the number of unique not Null values of the column of the first table." .

sup:Column_M_JOIN_DATA_STATISTICS__HOST a sup:Column ;
    rdfs:label "HOST column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "HOST" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(64)" ;
    rdfs:comment "Displays the host name." .

sup:Column_M_JOIN_DATA_STATISTICS__LAST_REFRESH_TIME a sup:Column ;
    rdfs:label "LAST_REFRESH_TIME column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "LAST_REFRESH_TIME" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the time when the statistics was last refreshed." .

sup:Column_M_JOIN_DATA_STATISTICS__MATCHING_VALUES_COUNTS1 a sup:Column ;
    rdfs:label "MATCHING_VALUES_COUNTS1 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "MATCHING_VALUES_COUNTS1" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(1000)" ;
    rdfs:comment "Displays a comma-separated list of counts of the first table's column values which find a join partner. Any matching values count refers to that value count with corresponding position in the list of value counts. An incomplete output of the list is truncated by an asterisk sign. If a uniform distribution of column values is assumed, then the matching values count the one and only value count that is calculated from the unified distribution of the value counts." .

sup:Column_M_JOIN_DATA_STATISTICS__MEMORY_SIZE a sup:Column ;
    rdfs:label "MEMORY_SIZE column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "MEMORY_SIZE" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the memory size, in bytes, used by the join data statistics object." .

sup:Column_M_JOIN_DATA_STATISTICS__PORT a sup:Column ;
    rdfs:label "PORT column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "PORT" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal port." .

sup:Column_M_JOIN_DATA_STATISTICS__RECORD_COUNT1 a sup:Column ;
    rdfs:label "RECORD_COUNT1 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "RECORD_COUNT1" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the estimated total row count of the first table. For temporary tables, this value is always 0." .

sup:Column_M_JOIN_DATA_STATISTICS__SCHEMA_NAME1 a sup:Column ;
    rdfs:label "SCHEMA_NAME1 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "SCHEMA_NAME1" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name of the first table" .

sup:Column_M_JOIN_DATA_STATISTICS__SCHEMA_NAME2 a sup:Column ;
    rdfs:label "SCHEMA_NAME2 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "SCHEMA_NAME2" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name of the second table. Join data statistics are not collected" .

sup:Column_M_JOIN_DATA_STATISTICS__TABLE_NAME1 a sup:Column ;
    rdfs:label "TABLE_NAME1 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "TABLE_NAME1" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the name of the first table" .

sup:Column_M_JOIN_DATA_STATISTICS__TABLE_NAME2 a sup:Column ;
    rdfs:label "TABLE_NAME2 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "TABLE_NAME2" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the name of the second table." .

sup:Column_M_JOIN_DATA_STATISTICS__VALUE_COUNTS1 a sup:Column ;
    rdfs:label "VALUE_COUNTS1 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "VALUE_COUNTS1" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(1000)" ;
    rdfs:comment "Displays a comma-separated sorted list of unique column value counts. An incomplete output of the list is truncated by an asterisk sign. If a uniform distribution of column values is assumed, then there is exactly one value count because values are uniformly distributed and every value counts the same." .

sup:Column_M_JOIN_DATA_STATISTICS__VALUE_COUNTS_FREQUENCIES1 a sup:Column ;
    rdfs:label "VALUE_COUNTS_FREQUENCIES1 column of M_JOIN_DATA_STATISTICS" ;
    sup:columnName "VALUE_COUNTS_FREQUENCIES1" ;
    sup:columnOf sup:View_M_JOIN_DATA_STATISTICS ;
    sup:dataType "NVARCHAR(1000)" ;
    rdfs:comment "Displays a comma-separated list of frequencies of the first table's column values with the same count. Any frequency refers to that value count with a corresponding position in the list of value counts. An incomplete output of the list is truncated by an asterisk sign. If a uniform distribution of column values is assumed, then there is exactly one value frequency because values are uniformly distributed. Generally, this single frequency matches the distinct count." .

sup:Column_M_JOIN_TRANSLATION_TABLES__COLUMN_NAME1 a sup:Column ;
    rdfs:label "COLUMN_NAME1 column of M_JOIN_TRANSLATION_TABLES" ;
    sup:columnName "COLUMN_NAME1" ;
    sup:columnOf sup:View_M_JOIN_TRANSLATION_TABLES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the first table's column name." .

