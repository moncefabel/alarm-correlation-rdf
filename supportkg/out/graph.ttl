sup:Column_M_LOG_SEGMENTS__SEGMENT_ID a sup:Column ;
    rdfs:label "SEGMENT_ID column of M_LOG_SEGMENTS" ;
    sup:columnName "SEGMENT_ID" ;
    sup:columnOf sup:View_M_LOG_SEGMENTS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the log segment ID within the partition." .

sup:Column_M_LOG_SEGMENTS__STATE a sup:Column ;
    rdfs:label "STATE column of M_LOG_SEGMENTS" ;
    sup:columnName "STATE" ;
    sup:columnOf sup:View_M_LOG_SEGMENTS ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the log segment state: Formatting The log segment is being formatted and not yet used. Preallocated The log segment has been preallocated but has never been used. Writing The log segment is currently being written. Closed The log segment is closed, not backed up and is still required for restart. Truncated The log segment is not required for restart, but has not been backed up. BackedUp The log segment has been backed up, but is still required for restart. RetainedFree The log segment has been backed up; it is not required for a restart but is needed to resynchronize the system replication sites. Free The log segment has been backed up, it is not required for restart and can be reused. ClosedIncoplete The log segment has been closed in an incomplete state on a system replication site. This is a temporary state that persists until system replication reconnects or a takeover occurs. FreeIncomplete The log segment has been designated as 'free' in an incomplete state, typically following scenarios like a system replication takeover or log corruption." .

sup:Column_M_LOG_SEGMENTS__TOTAL_SIZE a sup:Column ;
    rdfs:label "TOTAL_SIZE column of M_LOG_SEGMENTS" ;
    sup:columnName "TOTAL_SIZE" ;
    sup:columnOf sup:View_M_LOG_SEGMENTS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the total log segment size in bytes." .

sup:Column_M_LOG_SEGMENTS__USED_SIZE a sup:Column ;
