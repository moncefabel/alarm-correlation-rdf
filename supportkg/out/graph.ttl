sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__STORAGE_CONFIG_PARTITION a sup:Column ;
    rdfs:label "STORAGE_CONFIG_PARTITION column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "STORAGE_CONFIG_PARTITION" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the stable subpath to reassign the same storage partition after failovers." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__VOLUME_REPLICATION_ACTUAL_ROLE a sup:Column ;
    rdfs:label "VOLUME_REPLICATION_ACTUAL_ROLE column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "VOLUME_REPLICATION_ACTUAL_ROLE" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(256)" ;
