    rdfs:comment "Displays the generated site ID." .

sup:Column_M_SYSTEM_REPLICATION__SITE_NAME a sup:Column ;
    rdfs:label "SITE_NAME column of M_SYSTEM_REPLICATION" ;
    sup:columnName "SITE_NAME" ;
    sup:columnOf sup:View_M_SYSTEM_REPLICATION ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the site name." .

