sup:Column_M_JOINENGINE_STATISTICS__TRANSLATION_TABLE_COUNT a sup:Column ;
    rdfs:label "TRANSLATION_TABLE_COUNT column of M_JOINENGINE_STATISTICS" ;
    sup:columnName "TRANSLATION_TABLE_COUNT" ;
