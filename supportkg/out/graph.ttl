sup:Column_M_TABLE_PARTITIONS__LOADED a sup:Column ;
    rdfs:label "LOADED column of M_TABLE_PARTITIONS" ;
    sup:columnName "LOADED" ;
    sup:columnOf sup:View_M_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(10)" ;
    rdfs:comment "Displays the last time that the last-estimated memory consumptionDisplays how many columns in the table are loaded in memory. Valuse are: NO, PARTIALLY, or FULL. For a description of each column, see M_CS_COLUMNS." .

sup:Column_M_TABLE_PARTITIONS__LOAD_UNIT a sup:Column ;
    rdfs:label "LOAD_UNIT column of M_TABLE_PARTITIONS" ;
    sup:columnName "LOAD_UNIT" ;
    sup:columnOf sup:View_M_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(7)" ;
    rdfs:comment "Displays the effective load unit. Valid values are PAGE (when the partition uses page loadable storage) and COLUMN (when the partition uses column loadable storage)." .

sup:Column_M_TABLE_PARTITIONS__MEMORY_SIZE_IN_DELTA a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_DELTA column of M_TABLE_PARTITIONS" ;
    sup:columnName "MEMORY_SIZE_IN_DELTA" ;
    sup:columnOf sup:View_M_TABLE_PARTITIONS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the current memory consumption in delta in bytes." .

sup:Column_M_TABLE_PARTITIONS__MEMORY_SIZE_IN_MAIN a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_MAIN column of M_TABLE_PARTITIONS" ;
    sup:columnName "MEMORY_SIZE_IN_MAIN" ;
    sup:columnOf sup:View_M_TABLE_PARTITIONS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the current paged memory consumption in main in bytes. This value varies depending on the number of loaded attributes and includes data for open transactions." .

sup:Column_M_TABLE_PARTITIONS__MEMORY_SIZE_IN_PAGE_LOADABLE a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_PAGE_LOADABLE column of M_TABLE_PARTITIONS" ;
    sup:columnName "MEMORY_SIZE_IN_PAGE_LOADABLE" ;
    sup:columnOf sup:View_M_TABLE_PARTITIONS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the total resident paged memory size, in bytes, of the partition." .

sup:Column_M_TABLE_PARTITIONS__MEMORY_SIZE_IN_TOTAL a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_TOTAL column of M_TABLE_PARTITIONS" ;
    sup:columnName "MEMORY_SIZE_IN_TOTAL" ;
    sup:columnOf sup:View_M_TABLE_PARTITIONS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the total paged memory size in bytes, which is the sum of the memory in the main, delta, and history parts." .

sup:Column_M_TABLE_PARTITIONS__NODE_ID a sup:Column ;
    rdfs:label "NODE_ID column of M_TABLE_PARTITIONS" ;
    sup:columnName "NODE_ID" ;
    sup:columnOf sup:View_M_TABLE_PARTITIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the ID of the partition node." .

