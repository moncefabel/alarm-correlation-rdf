    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average number of times the NSE page had to be read from disk." .

sup:Column_M_SQL_PLAN_CACHE__AVG_BUFFER_CACHE_PINNED_MEMORY_SIZE a sup:Column ;
    rdfs:label "AVG_BUFFER_CACHE_PINNED_MEMORY_SIZE column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_BUFFER_CACHE_PINNED_MEMORY_SIZE" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average size of pinned the NSE page memory out of buffer cache." .

sup:Column_M_SQL_PLAN_CACHE__AVG_CALLED_THREAD_COUNT a sup:Column ;
    rdfs:label "AVG_CALLED_THREAD_COUNT column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_CALLED_THREAD_COUNT" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "REAL" ;
    rdfs:comment "Displays the average count of called threads used during plan execution." .

sup:Column_M_SQL_PLAN_CACHE__AVG_CURSOR_DURATION a sup:Column ;
    rdfs:label "AVG_CURSOR_DURATION column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_CURSOR_DURATION" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average time of the plan execution in microseconds, including the communication time with clients." .

sup:Column_M_SQL_PLAN_CACHE__AVG_EXECUTION_CLOSE_TIME a sup:Column ;
    rdfs:label "AVG_EXECUTION_CLOSE_TIME column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_EXECUTION_CLOSE_TIME" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average time for cursor close in microseconds." .

sup:Column_M_SQL_PLAN_CACHE__AVG_EXECUTION_CPU_TIME a sup:Column ;
    rdfs:label "AVG_EXECUTION_CPU_TIME column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_EXECUTION_CPU_TIME" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average amount of tracked CPU time." .

sup:Column_M_SQL_PLAN_CACHE__AVG_EXECUTION_FETCH_TIME a sup:Column ;
    rdfs:label "AVG_EXECUTION_FETCH_TIME column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_EXECUTION_FETCH_TIME" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average time for cursor fetch in microseconds." .

sup:Column_M_SQL_PLAN_CACHE__AVG_EXECUTION_MEMORY_SIZE a sup:Column ;
    rdfs:label "AVG_EXECUTION_MEMORY_SIZE column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_EXECUTION_MEMORY_SIZE" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average memory peak of all plan executions, in bytes." .

sup:Column_M_SQL_PLAN_CACHE__AVG_EXECUTION_OPEN_TIME a sup:Column ;
    rdfs:label "AVG_EXECUTION_OPEN_TIME column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_EXECUTION_OPEN_TIME" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average time that the cursor is open in microseconds." .

sup:Column_M_SQL_PLAN_CACHE__AVG_EXECUTION_TIME a sup:Column ;
    rdfs:label "AVG_EXECUTION_TIME column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_EXECUTION_TIME" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average time of the plan execution in microseconds." .

sup:Column_M_SQL_PLAN_CACHE__AVG_PREPARATION_TIME a sup:Column ;
    rdfs:label "AVG_PREPARATION_TIME column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_PREPARATION_TIME" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average time of the plan preparation in microseconds." .

sup:Column_M_SQL_PLAN_CACHE__AVG_SERVICE_NETWORK_REQUEST_COUNT a sup:Column ;
    rdfs:label "AVG_SERVICE_NETWORK_REQUEST_COUNT column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_SERVICE_NETWORK_REQUEST_COUNT" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "REAL" ;
    rdfs:comment "Displays the average count of service network requests during plan execution." .

sup:Column_M_SQL_PLAN_CACHE__AVG_SERVICE_NETWORK_REQUEST_DURATION a sup:Column ;
    rdfs:label "AVG_SERVICE_NETWORK_REQUEST_DURATION column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_SERVICE_NETWORK_REQUEST_DURATION" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "REAL" ;
    rdfs:comment "Displays the average time in microseconds of service network requests during plan execution." .

sup:Column_M_SQL_PLAN_CACHE__AVG_SERVICE_NETWORK_REQUEST_SIZE a sup:Column ;
    rdfs:label "AVG_SERVICE_NETWORK_REQUEST_SIZE column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_SERVICE_NETWORK_REQUEST_SIZE" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "REAL" ;
    rdfs:comment "Displays the average data amount in bytes of service network requests during plan execution." .

sup:Column_M_SQL_PLAN_CACHE__AVG_TABLE_LOAD_TIME_DURING_PREPARATION a sup:Column ;
    rdfs:label "AVG_TABLE_LOAD_TIME_DURING_PREPARATION column of M_SQL_PLAN_CACHE" ;
    sup:columnName "AVG_TABLE_LOAD_TIME_DURING_PREPARATION" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the average table loading time during plan preparation in microseconds." .

sup:Column_M_SQL_PLAN_CACHE__COMPILATION_OPTIONS a sup:Column ;
    rdfs:label "COMPILATION_OPTIONS column of M_SQL_PLAN_CACHE" ;
    sup:columnName "COMPILATION_OPTIONS" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "VARCHAR(128)" ;
    rdfs:comment "Displays the compilation options that are used by the SQL Query Optimizer when it generates cached execution plans: - Returns an empty string if the SQL Query Optimizer compiled without any special settings - Returns a STATEMENT HINT option when the SQL Query Optimizer compiles and optimizes with a statement hint - Returns an ABSTRACT SQL PLAN option when the SQL Query Optimizer compiles with an abstract sql plan - Returns a STATEMENT HINT ON INNER STATEMENT option when the SQLScript compiler applies a statement hint to an inner statement of this SQLScript plan. Multiple options can used together to create a list of options, for example: STATEMENT HINT, ABSTRACT SQL PLAN." .

sup:Column_M_SQL_PLAN_CACHE__EXECUTION_COUNT a sup:Column ;
    rdfs:label "EXECUTION_COUNT column of M_SQL_PLAN_CACHE" ;
    sup:columnName "EXECUTION_COUNT" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the accumulated count of the plan execution." .

sup:Column_M_SQL_PLAN_CACHE__EXECUTION_COUNT_BY_ROUTING a sup:Column ;
    rdfs:label "EXECUTION_COUNT_BY_ROUTING column of M_SQL_PLAN_CACHE" ;
    sup:columnName "EXECUTION_COUNT_BY_ROUTING" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the accumulated count of the plan execution by a client-routed connection in the statement routing. This column shows how many times the statement is executed in the routed connection. The routed connection is a physical connection in a part of the logical session." .

sup:Column_M_SQL_PLAN_CACHE__EXECUTION_ENGINE a sup:Column ;
    rdfs:label "EXECUTION_ENGINE column of M_SQL_PLAN_CACHE" ;
    sup:columnName "EXECUTION_ENGINE" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "VARCHAR(32)" ;
    rdfs:comment "Displays the list of all involved execution frameworks." .

sup:Column_M_SQL_PLAN_CACHE__HEX_REJECTION_REASON a sup:Column ;
    rdfs:label "HEX_REJECTION_REASON column of M_SQL_PLAN_CACHE" ;
    sup:columnName "HEX_REJECTION_REASON" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "NVARCHAR(5000)" ;
    rdfs:comment "Displays the reason for not using the HEX engine." .

sup:Column_M_SQL_PLAN_CACHE__HOST a sup:Column ;
    rdfs:label "HOST column of M_SQL_PLAN_CACHE" ;
    sup:columnName "HOST" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "VARCHAR(64)" ;
    rdfs:comment "Displays the host name." .

sup:Column_M_SQL_PLAN_CACHE__IS_DISTRIBUTED_EXECUTION a sup:Column ;
    rdfs:label "IS_DISTRIBUTED_EXECUTION column of M_SQL_PLAN_CACHE" ;
    sup:columnName "IS_DISTRIBUTED_EXECUTION" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "VARCHAR(5)" ;
    rdfs:comment "Displays whether tables are located in multiple nodes or multiple services are involved in plan execution (TRUE/FALSE)." .

sup:Column_M_SQL_PLAN_CACHE__IS_INTERNAL a sup:Column ;
    rdfs:label "IS_INTERNAL column of M_SQL_PLAN_CACHE" ;
    sup:columnName "IS_INTERNAL" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "VARCHAR(5)" ;
    rdfs:comment "Displays TRUE if the query plan was initiated from a database internal connection, not from the user nor other servers. For example, when an internal SAP HANA component executes a SQL statement related to the Statistics Service (_SYS_STATISTICS), or runs SQL statements in a background thread that exploit SQL Plan Cache, and so on. Displays FALSE if the query plan was initiated by a client application." .

sup:Column_M_SQL_PLAN_CACHE__IS_PINNED_PLAN a sup:Column ;
    rdfs:label "IS_PINNED_PLAN column of M_SQL_PLAN_CACHE" ;
    sup:columnName "IS_PINNED_PLAN" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "VARCHAR(5)" ;
    rdfs:comment "Displays whether the plan is explicitly stored by the PlanViz utility (TRUE/FALSE)." .

sup:Column_M_SQL_PLAN_CACHE__IS_VALID a sup:Column ;
    rdfs:label "IS_VALID column of M_SQL_PLAN_CACHE" ;
    sup:columnName "IS_VALID" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "VARCHAR(5)" ;
    rdfs:comment "Displays whether a plan is currently validated (TRUE/FALSE). A plan is invalidated when its corresponding schema objects, such as table and view, are changed. Invalidated plans are recompiled if the same statement is executed; otherwise, they are evicted by another plan when newly compiled." .

sup:Column_M_SQL_PLAN_CACHE__LAST_CONNECTION_ID a sup:Column ;
