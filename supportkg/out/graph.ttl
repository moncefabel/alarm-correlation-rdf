sup:Column_M_JOBEXECUTORS__FREE_WORKER_COUNT a sup:Column ;
    rdfs:label "FREE_WORKER_COUNT column of M_JOBEXECUTORS" ;
    sup:columnName "FREE_WORKER_COUNT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the total number of worker threads that are idle and may immediately take up a job to work on." .

sup:Column_M_JOBEXECUTORS__HOST a sup:Column ;
    rdfs:label "HOST column of M_JOBEXECUTORS" ;
    sup:columnName "HOST" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "NVARCHAR(64)" ;
    rdfs:comment "Displays the host name." .

sup:Column_M_JOBEXECUTORS__JOB_WAITING_WORKER_COUNT a sup:Column ;
    rdfs:label "JOB_WAITING_WORKER_COUNT column of M_JOBEXECUTORS" ;
    sup:columnName "JOB_WAITING_WORKER_COUNT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of worker threads waiting for a job on another worker thread." .

sup:Column_M_JOBEXECUTORS__MAX_CONCURRENCY a sup:Column ;
    rdfs:label "MAX_CONCURRENCY column of M_JOBEXECUTORS" ;
    sup:columnName "MAX_CONCURRENCY" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the maximum number of concurrently running worker threads. The job executor keeps MAX_CONCURRENCY worker threads busy. As a result, more worker threads are started if some worker threads are in a wait state for some time. Even if these additional worker threads are terminated, some of them are kept for later use and counted in PARKED_WORKER_COUNT." .

sup:Column_M_JOBEXECUTORS__MAX_CONCURRENCY_CONFIG a sup:Column ;
    rdfs:label "MAX_CONCURRENCY_CONFIG column of M_JOBEXECUTORS" ;
    sup:columnName "MAX_CONCURRENCY_CONFIG" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the maximum limit configured for concurrently running worker threads. If this limit is exceeded, a dynamic reduction in the concurrently running worker threads is automatically triggered, to prevent overload." .

sup:Column_M_JOBEXECUTORS__PARKED_WORKER_COUNT a sup:Column ;
    rdfs:label "PARKED_WORKER_COUNT column of M_JOBEXECUTORS" ;
    sup:columnName "PARKED_WORKER_COUNT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of parked worker threads." .

sup:Column_M_JOBEXECUTORS__PORT a sup:Column ;
    rdfs:label "PORT column of M_JOBEXECUTORS" ;
    sup:columnName "PORT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal port." .

sup:Column_M_JOBEXECUTORS__QUEUED_WAITING_JOB_COUNT a sup:Column ;
    rdfs:label "QUEUED_WAITING_JOB_COUNT column of M_JOBEXECUTORS" ;
    sup:columnName "QUEUED_WAITING_JOB_COUNT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the number of jobs queued for execution." .

sup:Column_M_JOBEXECUTORS__SYS_WAITING_WORKER_COUNT a sup:Column ;
    rdfs:label "SYS_WAITING_WORKER_COUNT column of M_JOBEXECUTORS" ;
    sup:columnName "SYS_WAITING_WORKER_COUNT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of worker threads waiting in system. A worker thread may wait for any other kind of synchronization." .

sup:Column_M_JOBEXECUTORS__TOTAL_WAITING_JOB_COUNT a sup:Column ;
    rdfs:label "TOTAL_WAITING_JOB_COUNT column of M_JOBEXECUTORS" ;
    sup:columnName "TOTAL_WAITING_JOB_COUNT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the number of all jobs waiting for execution." .

sup:Column_M_JOBEXECUTORS__TOTAL_WORKER_COUNT a sup:Column ;
    rdfs:label "TOTAL_WORKER_COUNT column of M_JOBEXECUTORS" ;
    sup:columnName "TOTAL_WORKER_COUNT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the total number of worker threads, including one extra worker thread for emergency diagnostic purposes." .

sup:Column_M_JOBEXECUTORS__WORKER_CREATE_COUNT a sup:Column ;
    rdfs:label "WORKER_CREATE_COUNT column of M_JOBEXECUTORS" ;
    sup:columnName "WORKER_CREATE_COUNT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the number of threads created." .

sup:Column_M_JOBEXECUTORS__YIELD_WAITING_WORKER_COUNT a sup:Column ;
    rdfs:label "YIELD_WAITING_WORKER_COUNT column of M_JOBEXECUTORS" ;
    sup:columnName "YIELD_WAITING_WORKER_COUNT" ;
    sup:columnOf sup:View_M_JOBEXECUTORS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of worker threads waiting on a yield. Sometimes a job running on a worker thread yields execution to another job that is more important." .

