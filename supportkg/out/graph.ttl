sup:Column_M_SQL_PLAN_CACHE__TOTAL_EXECUTION_MEMORY_SIZE a sup:Column ;
    rdfs:label "TOTAL_EXECUTION_MEMORY_SIZE column of M_SQL_PLAN_CACHE" ;
    sup:columnName "TOTAL_EXECUTION_MEMORY_SIZE" ;
    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the sum of memory peaks of all plan executions, in bytes. In cases where a query was executed in a scale-out system (that is, the query was running distributed across multiple hosts), then TOTAL_EXECUTION_MEMORY_SIZE is the highest peak memory usage across all involved hosts). So, if host A had a peak usage of 2 GB and host B has a peak usage of 3 GB, then MEMORY_SIZE displays 3 GB." .

