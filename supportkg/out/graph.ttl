    rdfs:comment "Displays the current classification values to assign hosts to logical worker groups." .

sup:Column_M_LANDSCAPE_HOST_CONFIGURATION__WORKER_CONFIG_GROUPS a sup:Column ;
    rdfs:label "WORKER_CONFIG_GROUPS column of M_LANDSCAPE_HOST_CONFIGURATION" ;
    sup:columnName "WORKER_CONFIG_GROUPS" ;
    sup:columnOf sup:View_M_LANDSCAPE_HOST_CONFIGURATION ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the stable classification values to assign hosts to logical worker groups." .

