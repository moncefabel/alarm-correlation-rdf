    rdfs:label "PARENT_OPERATOR_ID column of EXPLAIN_PLAN_TABLE" ;
    sup:columnName "PARENT_OPERATOR_ID" ;
    sup:columnOf sup:View_EXPLAIN_PLAN_TABLE ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the operator ID of the parent of an operator. The shape of a query plan is a tree and the topology of the tree can be reconstructed using OPERATOR_ID and PARENT_OPERATOR_ID. The PARENT_OPERATOR_ID of the root operator appears as NULL." .

sup:Column_EXPLAIN_PLAN_TABLE__PORT a sup:Column ;
    rdfs:label "PORT column of EXPLAIN_PLAN_TABLE" ;
    sup:columnName "PORT" ;
    sup:columnOf sup:View_EXPLAIN_PLAN_TABLE ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the port where the plan operator is generated." .

sup:Column_EXPLAIN_PLAN_TABLE__POSITION a sup:Column ;
    rdfs:label "POSITION column of EXPLAIN_PLAN_TABLE" ;
    sup:columnName "POSITION" ;
    sup:columnOf sup:View_EXPLAIN_PLAN_TABLE ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the position in the parent operator. The position of the first child is 1, the position of the second child is 2, and so on." .

sup:Column_EXPLAIN_PLAN_TABLE__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of EXPLAIN_PLAN_TABLE" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_EXPLAIN_PLAN_TABLE ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name the dependent object belongs to." .

sup:Column_EXPLAIN_PLAN_TABLE__STATEMENT_NAME a sup:Column ;
    rdfs:label "STATEMENT_NAME column of EXPLAIN_PLAN_TABLE" ;
    sup:columnName "STATEMENT_NAME" ;
    sup:columnOf sup:View_EXPLAIN_PLAN_TABLE ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the string specified as STATEMENT_NAME when executing the EXPLAIN PLAN command. This is used to distinguish plans from each other when there are multiple plans in EXPLAIN_PLAN_TABLE view." .

sup:Column_EXPLAIN_PLAN_TABLE__SUBTREE_COST a sup:Column ;
    rdfs:label "SUBTREE_COST column of EXPLAIN_PLAN_TABLE" ;
    sup:columnName "SUBTREE_COST" ;
    sup:columnOf sup:View_EXPLAIN_PLAN_TABLE ;
    sup:dataType "DOUBLE" ;
    rdfs:comment "Displays the estimated cost based on estimated cardinality information. This value is used for the cost-based optimizer to choose the best plan. The value can also be a possible indicator to compare two different plans for the same query; the smaller the subtree cost, typically the better the performance." .

sup:Column_EXPLAIN_PLAN_TABLE__TABLE_NAME a sup:Column ;
    rdfs:label "TABLE_NAME column of EXPLAIN_PLAN_TABLE" ;
    sup:columnName "TABLE_NAME" ;
    sup:columnOf sup:View_EXPLAIN_PLAN_TABLE ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the name of the database tables and views accessed by an operator." .

