sup:Column_M_CS_COLUMNS__COMPRESSION_TYPE a sup:Column ;
    rdfs:label "COMPRESSION_TYPE column of M_CS_COLUMNS" ;
    sup:columnName "COMPRESSION_TYPE" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the type of column compression: - SPARSE - PREFIXED - CLUSTERED - INDIRECT - RLE - DEFAULT (if the column is only dictionary coded)" .

sup:Column_M_CS_COLUMNS__COUNT a sup:Column ;
    rdfs:label "COUNT column of M_CS_COLUMNS" ;
    sup:columnName "COUNT" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the record count. This value is -1 if the count is not loaded." .

sup:Column_M_CS_COLUMNS__DISTINCT_COUNT a sup:Column ;
    rdfs:label "DISTINCT_COUNT column of M_CS_COLUMNS" ;
    sup:columnName "DISTINCT_COUNT" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays a distinct count of values, generally. This value is 0 if the count is not loaded. The values in this column are not equal to actual values that might be returned by a SELECT DISTINCT query. Do not use these values in a production system if precision is required." .

sup:Column_M_CS_COLUMNS__HOST a sup:Column ;
    rdfs:label "HOST column of M_CS_COLUMNS" ;
    sup:columnName "HOST" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(64)" ;
    rdfs:comment "Displays the host name." .

sup:Column_M_CS_COLUMNS__IMPLEMENTATION_FLAGS a sup:Column ;
    rdfs:label "IMPLEMENTATION_FLAGS column of M_CS_COLUMNS" ;
    sup:columnName "IMPLEMENTATION_FLAGS" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the internal implementation specification summary of the column." .

sup:Column_M_CS_COLUMNS__INDEX_LOADED a sup:Column ;
    rdfs:label "INDEX_LOADED column of M_CS_COLUMNS" ;
    sup:columnName "INDEX_LOADED" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the load status of the inverted index: NOT APPLICABLE, UNLOADED, or LOADED." .

sup:Column_M_CS_COLUMNS__INDEX_TYPE a sup:Column ;
    rdfs:label "INDEX_TYPE column of M_CS_COLUMNS" ;
    sup:columnName "INDEX_TYPE" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the type of inverted index: FULL Displays that a conventional index is defined on the column. BLOCK Displays that a block index is defined on the column. MINMAX Displays that a min-max index is defined on the column. NONE Displays that no index is defined on the column." .

sup:Column_M_CS_COLUMNS__LAST_ACCESS_TIME a sup:Column ;
    rdfs:label "LAST_ACCESS_TIME column of M_CS_COLUMNS" ;
    sup:columnName "LAST_ACCESS_TIME" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the last time that the column was read or there was an INSERT to, UPDATE of, or DELETE from the column. This value is undefined for unloaded columns." .

sup:Column_M_CS_COLUMNS__LAST_LOAD_TIME a sup:Column ;
    rdfs:label "LAST_LOAD_TIME column of M_CS_COLUMNS" ;
    sup:columnName "LAST_LOAD_TIME" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the last time that the column was loaded. This is undefined for unloaded columns." .

sup:Column_M_CS_COLUMNS__LOADED a sup:Column ;
    rdfs:label "LOADED column of M_CS_COLUMNS" ;
    sup:columnName "LOADED" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Indicates whether the column is loaded into the memory: TRUE/FALSE." .

sup:Column_M_CS_COLUMNS__LOADED_FROM_PERSISTENT_MEMORY a sup:Column ;
    rdfs:label "LOADED_FROM_PERSISTENT_MEMORY column of M_CS_COLUMNS" ;
    sup:columnName "LOADED_FROM_PERSISTENT_MEMORY" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether the column was loaded from persistent memory: TRUE/FALSE." .

sup:Column_M_CS_COLUMNS__LOAD_UNIT a sup:Column ;
    rdfs:label "LOAD_UNIT column of M_CS_COLUMNS" ;
    sup:columnName "LOAD_UNIT" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(7)" ;
    rdfs:comment "Displays the load unit for the column: PAGE, COLUMN, and UNKNOWN." .

sup:Column_M_CS_COLUMNS__MEMORY_SIZE_IN_DELTA a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_DELTA column of M_CS_COLUMNS" ;
    sup:columnName "MEMORY_SIZE_IN_DELTA" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the current memory consumption, in bytes, in delta. Returns 0 if the memory is not loaded in delta." .

sup:Column_M_CS_COLUMNS__MEMORY_SIZE_IN_MAIN a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_MAIN column of M_CS_COLUMNS" ;
    sup:columnName "MEMORY_SIZE_IN_MAIN" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the current memory consumption, in bytes, in main. Returns 0 if the memory is not loaded in main." .

sup:Column_M_CS_COLUMNS__MEMORY_SIZE_IN_PAGE_LOADABLE_MAIN a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_PAGE_LOADABLE_MAIN column of M_CS_COLUMNS" ;
    sup:columnName "MEMORY_SIZE_IN_PAGE_LOADABLE_MAIN" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the total paged memory size of the column in bytes." .

sup:Column_M_CS_COLUMNS__MEMORY_SIZE_IN_TOTAL a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_TOTAL column of M_CS_COLUMNS" ;
    sup:columnName "MEMORY_SIZE_IN_TOTAL" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the sum, in bytes, of the memory used." .

sup:Column_M_CS_COLUMNS__NUMA_NODE_INDEX a sup:Column ;
    rdfs:label "NUMA_NODE_INDEX column of M_CS_COLUMNS" ;
    sup:columnName "NUMA_NODE_INDEX" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "SMALLINT" ;
    rdfs:comment "Displays the NUMA node index where allocations are performed and columns are loaded. > ### Note: > The value -1 for NUME_NODE_INDEX indicates that the supplied NUMA (Non-Uniform Memory Access) number is invalid. This can occur when there is only one NUMA node available in the system, and the provided NUMA number is greater than one. In this case, the value will be set to -1. > > Additionally, a -1 value for the NUMA node index can also signify that no specific and valid node is defined. This might be the case when NUMA handling is completely disabled for a system, either manually or when there is only one socket, which means there is no NUMA configuration." .

sup:Column_M_CS_COLUMNS__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of M_CS_COLUMNS" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Returns the table partition ID: - For partitioned tables, the part ID is equal to the sequential number of the partition, starting at 1. - For replicated tables, the part ID is 1 for the original table and subsequent part IDs are assigned to replica tables. - The part ID is 0 for tables that are not partitioned. - The part ID -1 indicates that the table schema is being modified." .

sup:Column_M_CS_COLUMNS__PERSISTENT_MEMORY a sup:Column ;
    rdfs:label "PERSISTENT_MEMORY column of M_CS_COLUMNS" ;
    sup:columnName "PERSISTENT_MEMORY" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays the persistent memory preference inferred from the user-specified preferences in a bottom-up manner starting from this object: TRUE/FALSE." .

sup:Column_M_CS_COLUMNS__PERSISTENT_MEMORY_FILE_NAME a sup:Column ;
    rdfs:label "PERSISTENT_MEMORY_FILE_NAME column of M_CS_COLUMNS" ;
    sup:columnName "PERSISTENT_MEMORY_FILE_NAME" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the name of the persistent memory file associated with the column. If there is no associated persistent memory file, then NULL is returned." .

sup:Column_M_CS_COLUMNS__PERSISTENT_MEMORY_SIZE_IN_TOTAL a sup:Column ;
    rdfs:label "PERSISTENT_MEMORY_SIZE_IN_TOTAL column of M_CS_COLUMNS" ;
    sup:columnName "PERSISTENT_MEMORY_SIZE_IN_TOTAL" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "For columns stored in persistent memory, displays the total memory size in bytes." .

sup:Column_M_CS_COLUMNS__PORT a sup:Column ;
    rdfs:label "PORT column of M_CS_COLUMNS" ;
    sup:columnName "PORT" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the internal port." .

sup:Column_M_CS_COLUMNS__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of M_CS_COLUMNS" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name." .

sup:Column_M_CS_COLUMNS__STORED_IN_PERSISTENT_MEMORY a sup:Column ;
    rdfs:label "STORED_IN_PERSISTENT_MEMORY column of M_CS_COLUMNS" ;
    sup:columnName "STORED_IN_PERSISTENT_MEMORY" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether there is an associated persistent memory block: TRUE/FALSE." .

sup:Column_M_CS_COLUMNS__TABLE_NAME a sup:Column ;
    rdfs:label "TABLE_NAME column of M_CS_COLUMNS" ;
    sup:columnName "TABLE_NAME" ;
    sup:columnOf sup:View_M_CS_COLUMNS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the table name." .

sup:Column_M_CS_INDEXES__CONCAT_COLUMN_NAME a sup:Column ;
    rdfs:label "CONCAT_COLUMN_NAME column of M_CS_INDEXES" ;
    sup:columnName "CONCAT_COLUMN_NAME" ;
    sup:columnOf sup:View_M_CS_INDEXES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the name of the concat column in the case of multi-column indexes. This is empty in the case of a single-column index." .

sup:Column_M_CS_INDEXES__HASH_COLLISION_COUNT a sup:Column ;
    rdfs:label "HASH_COLLISION_COUNT column of M_CS_INDEXES" ;
    sup:columnName "HASH_COLLISION_COUNT" ;
    sup:columnOf sup:View_M_CS_INDEXES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the count of hash collisions aggregated over all values." .

sup:Column_M_CS_INDEXES__HOST a sup:Column ;
    rdfs:label "HOST column of M_CS_INDEXES" ;
    sup:columnName "HOST" ;
    sup:columnOf sup:View_M_CS_INDEXES ;
    sup:dataType "NVARCHAR(64)" ;
    rdfs:comment "Displays the host name." .

sup:Column_M_CS_INDEXES__INDEX_NAME a sup:Column ;
    rdfs:label "INDEX_NAME column of M_CS_INDEXES" ;
    sup:columnName "INDEX_NAME" ;
    sup:columnOf sup:View_M_CS_INDEXES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the index name." .

sup:Column_M_CS_INDEXES__INVERTED_INDIVIDUAL_COST a sup:Column ;
    rdfs:label "INVERTED_INDIVIDUAL_COST column of M_CS_INDEXES" ;
    sup:columnName "INVERTED_INDIVIDUAL_COST" ;
    sup:columnOf sup:View_M_CS_INDEXES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the cost value for INVERTED INDIVIDUAL index type. This cost value is an indicator for the possible performance impact when switching between different index-types. A high cost value indicates a possible high overhead when using INVERTED INDIVIDUAL index-type compared to INVERTED VALUE index-type. A cost value of 1 indicates that there is no overhead. For non composite or non-unique indexes the value is -1, which indicates that no cost value is available." .

sup:Column_M_CS_INDEXES__MEMORY_SIZE_IN_CONCAT a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_CONCAT column of M_CS_INDEXES" ;
    sup:columnName "MEMORY_SIZE_IN_CONCAT" ;
    sup:columnOf sup:View_M_CS_INDEXES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the total size of the concat in bytes." .

sup:Column_M_CS_INDEXES__MEMORY_SIZE_IN_TOTAL a sup:Column ;
    rdfs:label "MEMORY_SIZE_IN_TOTAL column of M_CS_INDEXES" ;
    sup:columnName "MEMORY_SIZE_IN_TOTAL" ;
    sup:columnOf sup:View_M_CS_INDEXES ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the total size of the concat plus the sum of the inverted index sizes of the single index columns in bytes." .

sup:Column_M_CS_INDEXES__MOST_SELECTIVE_COLUMN_NAME a sup:Column ;
    rdfs:label "MOST_SELECTIVE_COLUMN_NAME column of M_CS_INDEXES" ;
    sup:columnName "MOST_SELECTIVE_COLUMN_NAME" ;
    sup:columnOf sup:View_M_CS_INDEXES ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the name of the most selective index column of a composite index. The most selective column is the one with lowest cost value." .

sup:Column_M_CS_INDEXES__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of M_CS_INDEXES" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_M_CS_INDEXES ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the partition ID. Returns the following: - For partitioned tables, the part ID is equal to the sequential number of the partition, starting at 1. - In the case of replicated tables, the part ID is 1 for the original table and subsequent part IDs are assigned to replica tables. - The part ID is 0 for tables that are not partitioned. - A part ID value of -1 indicates that a modification of the table schema is in progress." .

