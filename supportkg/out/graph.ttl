    sup:columnOf sup:View_M_CS_ALL_COLUMNS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the amount of persistent memory, in bytes, that is not directly mapped to a corresponding data structure during load, but was only read to construct the data structure in DRAM. This column also includes persistent memory block overhead if the requested persistent memory allocation is not a multiple of a block size." .

sup:Column_M_CS_ALL_COLUMNS__MEMORY_SIZE_IN_DELTA a sup:Column ;
