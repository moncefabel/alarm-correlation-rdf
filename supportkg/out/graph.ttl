    rdfs:comment "Displays the recommended display line style: 1=solid, 2=dotted, 3=dashed." .

sup:Column_M_JOB_HISTORY_INFO__DISPLAY_NAME a sup:Column ;
    rdfs:label "DISPLAY_NAME column of M_JOB_HISTORY_INFO" ;
