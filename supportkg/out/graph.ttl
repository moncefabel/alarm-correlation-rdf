    sup:columnOf sup:View_M_SQL_PLAN_CACHE ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays an average batch count per one execution for cached DML plans." .

sup:Column_M_SQL_PLAN_CACHE__AVG_BUFFER_CACHE_IO_READ_SIZE a sup:Column ;
    rdfs:label "AVG_BUFFER_CACHE_IO_READ_SIZE column of M_SQL_PLAN_CACHE" ;
