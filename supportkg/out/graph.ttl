    sup:columnOf sup:View_M_CS_ALL_COLUMNS ;
    sup:dataType "TIMESTAMP" ;
    rdfs:comment "Displays the last time that the column was read or there was an INSERT to, UPDATE of, or DELETE from the column. This value is undefined for unloaded columns." .

sup:Column_M_CS_ALL_COLUMNS__LAST_LOAD_TIME a sup:Column ;
