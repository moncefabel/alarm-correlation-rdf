sup:Column_M_TABLE_PARTITIONS__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of M_TABLE_PARTITIONS" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_M_TABLE_PARTITIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the table partition ID: - For partitioned tables, the part ID is equal to the sequential number of the partition, starting at 1. - For replicated tables, the part ID is 1 for the original table and subsequent part IDs are assigned to replica tables. - The part ID is 0 for tables that are not partitioned. - A part ID value of -1 indicates that a modification of the table schema is currently in progress." .

sup:Column_M_TABLE_PARTITIONS__PERSISTENT_MEMORY_SIZE_IN_TOTAL a sup:Column ;
