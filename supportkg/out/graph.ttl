sup:Column_M_DEBUG_CONNECTIONS__OPERATION a sup:Column ;
    rdfs:label "OPERATION column of M_DEBUG_CONNECTIONS" ;
    sup:columnName "OPERATION" ;
    sup:columnOf sup:View_M_DEBUG_CONNECTIONS ;
    sup:dataType "NVARCHAR(512)" ;
    rdfs:comment "Displays the operation that is currently running within this connection." .

sup:Column_M_DEBUG_SESSIONS__ATTACH_COUNT a sup:Column ;
    rdfs:label "ATTACH_COUNT column of M_DEBUG_SESSIONS" ;
    sup:columnName "ATTACH_COUNT" ;
    sup:columnOf sup:View_M_DEBUG_SESSIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the number of debuggees the debugger is currently attached to." .

sup:Column_M_DEBUG_SESSIONS__ATTACH_FILTER_APPLICATION_USER_NAME a sup:Column ;
    rdfs:label "ATTACH_FILTER_APPLICATION_USER_NAME column of M_DEBUG_SESSIONS" ;
