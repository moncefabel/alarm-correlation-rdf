    sup:columnOf sup:View_M_TABLE_LOB_STATISTICS ;
    sup:dataType "NVARCHAR(7)" ;
    rdfs:comment "Displays that the LOB storage type is one of the following: INPLACE Small LOBs (completely loaded into the main memory). PACKED Medium-sized LOBs where the size is between two thresholds (only loaded into the main memory when required). FILE Large LOBs (individually loaded into the main memory on demand)." .

sup:Column_M_TABLE_LOB_STATISTICS__MEMORY_PAGE_COUNT a sup:Column ;
