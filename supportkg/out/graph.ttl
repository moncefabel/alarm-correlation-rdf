    rdfs:comment "Displays the internal port number." .

sup:Column_M_DATA_VOLUME_SUPERBLOCK_STATISTICS__STATE a sup:Column ;
    rdfs:label "STATE column of M_DATA_VOLUME_SUPERBLOCK_STATISTICS" ;
    sup:columnName "STATE" ;
    sup:columnOf sup:View_M_DATA_VOLUME_SUPERBLOCK_STATISTICS ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the data volume state: ACTIVATING, ACTIVE, or DEACTIVATING." .

sup:Column_M_DATA_VOLUME_SUPERBLOCK_STATISTICS__SUPERBLOCK_COUNT a sup:Column ;
