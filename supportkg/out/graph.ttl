sup:Column_M_DEBUG_SESSIONS__ATTACH_FILTER_DEBUG_TOKEN a sup:Column ;
    rdfs:label "ATTACH_FILTER_DEBUG_TOKEN column of M_DEBUG_SESSIONS" ;
    sup:columnName "ATTACH_FILTER_DEBUG_TOKEN" ;
    sup:columnOf sup:View_M_DEBUG_SESSIONS ;
    sup:dataType "NVARCHAR(32)" ;
    rdfs:comment "Displays the debug token the debugger is using to attach to connections." .

sup:Column_M_DEBUG_SESSIONS__ATTACH_FILTER_USER_NAME a sup:Column ;
    rdfs:label "ATTACH_FILTER_USER_NAME column of M_DEBUG_SESSIONS" ;
    sup:columnName "ATTACH_FILTER_USER_NAME" ;
    sup:columnOf sup:View_M_DEBUG_SESSIONS ;
