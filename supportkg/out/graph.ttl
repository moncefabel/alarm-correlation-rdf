sup:Column_TABLE_COLUMNS__FUZZY_SEARCH_INDEX a sup:Column ;
    rdfs:label "FUZZY_SEARCH_INDEX column of TABLE_COLUMNS" ;
    sup:columnName "FUZZY_SEARCH_INDEX" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays if the column has a fuzzy search index: TRUE or FALSE." .

sup:Column_TABLE_COLUMNS__FUZZY_SEARCH_MODE a sup:Column ;
