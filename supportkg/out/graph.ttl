    sup:dataType "NVARCHAR(32)" ;
    rdfs:comment "Displays the fuzzy search mode." .

sup:Column_TABLE_COLUMNS__GENERATED_ALWAYS_AS a sup:Column ;
    rdfs:label "GENERATED_ALWAYS_AS column of TABLE_COLUMNS" ;
    sup:columnName "GENERATED_ALWAYS_AS" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(1000)" ;
    rdfs:comment "Displays the expression of the column created by GENERATED... AS." .

sup:Column_TABLE_COLUMNS__GENERATION_TYPE a sup:Column ;
    rdfs:label "GENERATION_TYPE column of TABLE_COLUMNS" ;
    sup:columnName "GENERATION_TYPE" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(22)" ;
    rdfs:comment "Displays ALWAYS AS if the column is generation column, ALWAYS AS IDENTITY, BY DEFAULT AS IDENTITY if the column is an identity column whose values are always generated or generated by default, and NULL otherwise. For system-versioning columns, the value 'ALWAYS AS ROW START' indicates a column that was defined as GENERATED ALWAYS AS ROW START, while the value 'ALWAYS AS ROW END' indicates a column that was defined as GENERATED ALWAYS AS ROW END." .

sup:Column_TABLE_COLUMNS__INDEX_TYPE a sup:Column ;
    rdfs:label "INDEX_TYPE column of TABLE_COLUMNS" ;
    sup:columnName "INDEX_TYPE" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(4)" ;
    rdfs:comment "Indicates the type of index: NONE or FULL." .

sup:Column_TABLE_COLUMNS__IS_CACHABLE a sup:Column ;
    rdfs:label "IS_CACHABLE column of TABLE_COLUMNS" ;
    sup:columnName "IS_CACHABLE" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether the column is part of cached data: TRUE or FALSE." .

sup:Column_TABLE_COLUMNS__IS_CACHE_KEY a sup:Column ;
    rdfs:label "IS_CACHE_KEY column of TABLE_COLUMNS" ;
    sup:columnName "IS_CACHE_KEY" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether the column is part of cache key: TRUE or FALSE." .

sup:Column_TABLE_COLUMNS__IS_HIDDEN a sup:Column ;
    rdfs:label "IS_HIDDEN column of TABLE_COLUMNS" ;
    sup:columnName "IS_HIDDEN" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether the column is hidden: TRUE or FALSE." .

sup:Column_TABLE_COLUMNS__IS_MASKED a sup:Column ;
    rdfs:label "IS_MASKED column of TABLE_COLUMNS" ;
    sup:columnName "IS_MASKED" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether the column is masked: TRUE or FALSE." .

sup:Column_TABLE_COLUMNS__IS_NULLABLE a sup:Column ;
    rdfs:label "IS_NULLABLE column of TABLE_COLUMNS" ;
    sup:columnName "IS_NULLABLE" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether the column is allowed to accept null values: TRUE or FALSE." .

sup:Column_TABLE_COLUMNS__LENGTH a sup:Column ;
    rdfs:label "LENGTH column of TABLE_COLUMNS" ;
    sup:columnName "LENGTH" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Indicates the number of chars for CHAR types, number of max digits for numeric types, number of chars for datetime types, and number of bytes for LOB types." .

sup:Column_TABLE_COLUMNS__LOAD_UNIT a sup:Column ;
    rdfs:label "LOAD_UNIT column of TABLE_COLUMNS" ;
    sup:columnName "LOAD_UNIT" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(7)" ;
    rdfs:comment "Displays the unit of column data loading: TABLE, COLUMN, PAGE, or DEFAULT." .

sup:Column_TABLE_COLUMNS__MASK_EXPRESSION a sup:Column ;
    rdfs:label "MASK_EXPRESSION column of TABLE_COLUMNS" ;
    sup:columnName "MASK_EXPRESSION" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(5000)" ;
    rdfs:comment "Displays the mask expression. See Permissions for further details." .

sup:Column_TABLE_COLUMNS__MEMORY_THRESHOLD a sup:Column ;
    rdfs:label "MEMORY_THRESHOLD column of TABLE_COLUMNS" ;
    sup:columnName "MEMORY_THRESHOLD" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the memory threshold in bytes for LOB types." .

sup:Column_TABLE_COLUMNS__NUMA_NODE_INDEXES a sup:Column ;
    rdfs:label "NUMA_NODE_INDEXES column of TABLE_COLUMNS" ;
    sup:columnName "NUMA_NODE_INDEXES" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR (1024)" ;
    rdfs:comment "Displays a comma-separated list of user-specified logical NUMA node indexes for the table columns. For each column entry in this view there will be preferences (if set); otherwise, the value is NULL. The elements of the list are either individual nodes indexes or ranges of index nodes, or a mixture of both. For example, the value ***0, 1 TO 3, 6*** indicates node indexes 0, 1, 2, 3, and 6." .

sup:Column_TABLE_COLUMNS__OFFSET a sup:Column ;
    rdfs:label "OFFSET column of TABLE_COLUMNS" ;
    sup:columnName "OFFSET" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "SMALLINT" ;
    rdfs:comment "Displays the offset of the column in the record." .

sup:Column_TABLE_COLUMNS__PERSISTENT_MEMORY a sup:Column ;
    rdfs:label "PERSISTENT_MEMORY column of TABLE_COLUMNS" ;
    sup:columnName "PERSISTENT_MEMORY" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays the user-specified persistent memory preference: TRUE (persistent memory is ON), or FALSE (persistent memory OFF). If the user has not specified a persistent memory preference, or if the preference is set to the default, then the value is NULL." .

sup:Column_TABLE_COLUMNS__POSITION a sup:Column ;
    rdfs:label "POSITION column of TABLE_COLUMNS" ;
    sup:columnName "POSITION" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Indicates the ordinal position of the column in a record." .

sup:Column_TABLE_COLUMNS__PRELOAD a sup:Column ;
    rdfs:label "PRELOAD column of TABLE_COLUMNS" ;
    sup:columnName "PRELOAD" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays if the column is preloaded: TRUE or FALSE. Preload information can be NULL in case of row storeor virtual columns." .

sup:Column_TABLE_COLUMNS__ROW_ORDER_POSITION a sup:Column ;
    rdfs:label "ROW_ORDER_POSITION column of TABLE_COLUMNS" ;
    sup:columnName "ROW_ORDER_POSITION" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "SMALLINT" ;
    rdfs:comment "Displays the position of the row in the table." .

sup:Column_TABLE_COLUMNS__SCALE a sup:Column ;
    rdfs:label "SCALE column of TABLE_COLUMNS" ;
    sup:columnName "SCALE" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Indicates the numeric types: the maximum number of digits to the right of the decimal point; time, timestamp: the decimal digits are defined as the number of digits to the right of the decimal point in the second's component of the data." .

sup:Column_TABLE_COLUMNS__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of TABLE_COLUMNS" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name." .

sup:Column_TABLE_COLUMNS__TABLE_NAME a sup:Column ;
    rdfs:label "TABLE_NAME column of TABLE_COLUMNS" ;
    sup:columnName "TABLE_NAME" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the table name." .

