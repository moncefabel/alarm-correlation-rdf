    rdfs:label "IS_GROUP_LEAD column of TABLE_GROUPS" ;
    sup:columnName "IS_GROUP_LEAD" ;
    sup:columnOf sup:View_TABLE_GROUPS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Determines the leading table within a group." .

sup:Column_TABLE_GROUPS__SCHEMA_NAME a sup:Column ;
    rdfs:label "SCHEMA_NAME column of TABLE_GROUPS" ;
    sup:columnName "SCHEMA_NAME" ;
    sup:columnOf sup:View_TABLE_GROUPS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the schema name." .

sup:Column_TABLE_GROUPS__SUBTYPE a sup:Column ;
    rdfs:label "SUBTYPE column of TABLE_GROUPS" ;
    sup:columnName "SUBTYPE" ;
    sup:columnOf sup:View_TABLE_GROUPS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the subtype." .

sup:Column_TABLE_GROUPS__TABLE_NAME a sup:Column ;
    rdfs:label "TABLE_NAME column of TABLE_GROUPS" ;
    sup:columnName "TABLE_NAME" ;
    sup:columnOf sup:View_TABLE_GROUPS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the table name." .

sup:Column_TABLE_PARTITIONS__DYNAMIC_DISTANCE_INTERVAL a sup:Column ;
    rdfs:label "DYNAMIC_DISTANCE_INTERVAL column of TABLE_PARTITIONS" ;
    sup:columnName "DYNAMIC_DISTANCE_INTERVAL" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the dynamic aging distance interval." .

sup:Column_TABLE_PARTITIONS__DYNAMIC_DISTANCE_LOAD_UNIT a sup:Column ;
    rdfs:label "DYNAMIC_DISTANCE_LOAD_UNIT column of TABLE_PARTITIONS" ;
    sup:columnName "DYNAMIC_DISTANCE_LOAD_UNIT" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(7)" ;
    rdfs:comment "Displays the dynamic aging distance load unit." .

sup:Column_TABLE_PARTITIONS__DYNAMIC_RANGE_DIRECTION a sup:Column ;
    rdfs:label "DYNAMIC_RANGE_DIRECTION column of TABLE_PARTITIONS" ;
    sup:columnName "DYNAMIC_RANGE_DIRECTION" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the direction of the dynamic range: INCREASING, DECREASING, or BIDIRECTIONAL." .

sup:Column_TABLE_PARTITIONS__DYNAMIC_RANGE_INTERVAL a sup:Column ;
    rdfs:label "DYNAMIC_RANGE_INTERVAL column of TABLE_PARTITIONS" ;
    sup:columnName "DYNAMIC_RANGE_INTERVAL" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(32)" ;
    rdfs:comment "Displays the interval value and type by which new partitions can be created dynamically." .

sup:Column_TABLE_PARTITIONS__DYNAMIC_RANGE_THRESHOLD a sup:Column ;
    rdfs:label "DYNAMIC_RANGE_THRESHOLD column of TABLE_PARTITIONS" ;
    sup:columnName "DYNAMIC_RANGE_THRESHOLD" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "BIGINT" ;
    rdfs:comment "Displays the threshold after which a new partition will be created dynamically." .

sup:Column_TABLE_PARTITIONS__GROUP_NAME a sup:Column ;
    rdfs:label "GROUP_NAME column of TABLE_PARTITIONS" ;
    sup:columnName "GROUP_NAME" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the group name." .

sup:Column_TABLE_PARTITIONS__GROUP_TYPE a sup:Column ;
    rdfs:label "GROUP_TYPE column of TABLE_PARTITIONS" ;
    sup:columnName "GROUP_TYPE" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(256)" ;
    rdfs:comment "Displays the group type." .

sup:Column_TABLE_PARTITIONS__INSERT a sup:Column ;
    rdfs:label "INSERT column of TABLE_PARTITIONS" ;
    sup:columnName "INSERT" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether INSERT statements are allowed on the partition: TRUE/FALSE." .

sup:Column_TABLE_PARTITIONS__IS_DYNAMIC a sup:Column ;
    rdfs:label "IS_DYNAMIC column of TABLE_PARTITIONS" ;
    sup:columnName "IS_DYNAMIC" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(5)" ;
    rdfs:comment "Displays whether a partition is dynamic: TRUE or FALSE." .

sup:Column_TABLE_PARTITIONS__IS_MOVABLE a sup:Column ;
    rdfs:label "IS_MOVABLE column of TABLE_PARTITIONS" ;
    sup:columnName "IS_MOVABLE" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR" ;
    rdfs:comment "Displays whether a partition can be movable. Valid values are: MOVABLE, NOT MOVABLE, and DEFAULT." .

sup:Column_TABLE_PARTITIONS__LEVEL_1_PARTITION a sup:Column ;
    rdfs:label "LEVEL_1_PARTITION column of TABLE_PARTITIONS" ;
    sup:columnName "LEVEL_1_PARTITION" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the first level partition ID. Possible values are 1 through the number of first-level partitions. First-level partitions (those used in ALTER TABLE...MOVE) may have subpartitions." .

sup:Column_TABLE_PARTITIONS__LEVEL_1_RANGE_MAX_VALUE a sup:Column ;
    rdfs:label "LEVEL_1_RANGE_MAX_VALUE column of TABLE_PARTITIONS" ;
    sup:columnName "LEVEL_1_RANGE_MAX_VALUE" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(5000)" ;
    rdfs:comment "Specifies the exclusive maximum value of the range partition at the first level for a range-partitioned table; empty otherwise. This value is not included in the range." .

sup:Column_TABLE_PARTITIONS__LEVEL_1_RANGE_MIN_VALUE a sup:Column ;
    rdfs:label "LEVEL_1_RANGE_MIN_VALUE column of TABLE_PARTITIONS" ;
    sup:columnName "LEVEL_1_RANGE_MIN_VALUE" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(5000)" ;
    rdfs:comment "Displays the minimum value of the range partition at the first level for a range-partitioned table; empty otherwise." .

sup:Column_TABLE_PARTITIONS__LEVEL_2_PARTITION a sup:Column ;
    rdfs:label "LEVEL_2_PARTITION column of TABLE_PARTITIONS" ;
    sup:columnName "LEVEL_2_PARTITION" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the second-level partition (first-level subpartition) ID. Possible values are 0 for tables without multilevel partitioning and 1 through the number of subpartitions for partitioned tables with multilevel partitioning." .

sup:Column_TABLE_PARTITIONS__LEVEL_2_RANGE_MAX_VALUE a sup:Column ;
    rdfs:label "LEVEL_2_RANGE_MAX_VALUE column of TABLE_PARTITIONS" ;
    sup:columnName "LEVEL_2_RANGE_MAX_VALUE" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(5000)" ;
    rdfs:comment "Specifies the exclusive maximum value of the range partition at the second level (first-level subpartition) for a range-partitioned table; empty otherwise. This value is not included in the range." .

sup:Column_TABLE_PARTITIONS__LEVEL_2_RANGE_MIN_VALUE a sup:Column ;
    rdfs:label "LEVEL_2_RANGE_MIN_VALUE column of TABLE_PARTITIONS" ;
    sup:columnName "LEVEL_2_RANGE_MIN_VALUE" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(5000)" ;
    rdfs:comment "Displays the minimum value of the range partition at the second level partition (first-level subpartition) for a range-partitioned table; empty otherwise." .

sup:Column_TABLE_PARTITIONS__LEVEL_3_PARTITION a sup:Column ;
    rdfs:label "LEVEL_3_PARTITION column of TABLE_PARTITIONS" ;
    sup:columnName "LEVEL_3_PARTITION" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the third-level partition (second-level subpartition) ID. Possible values are 1 through the number of first-level partitions. Second-level partitions (those used in ALTER TABLE...MOVE) may have subpartitions." .

sup:Column_TABLE_PARTITIONS__LEVEL_3_RANGE_MAX_VALUE a sup:Column ;
    rdfs:label "LEVEL_3_RANGE_MAX_VALUE column of TABLE_PARTITIONS" ;
    sup:columnName "LEVEL_3_RANGE_MAX_VALUE" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(5000)" ;
    rdfs:comment "Specifies the exclusive maximum value of the range partition at the third level (second-level subpartition) for a range-partitioned table; empty otherwise. This value is not included in the range." .

sup:Column_TABLE_PARTITIONS__LEVEL_3_RANGE_MIN_VALUE a sup:Column ;
    rdfs:label "LEVEL_3_RANGE_MIN_VALUE column of TABLE_PARTITIONS" ;
    sup:columnName "LEVEL_3_RANGE_MIN_VALUE" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(5000)" ;
    rdfs:comment "Displays the minimum value of the range partition at the third level partition (second-level subpartition) for a range-partitioned table; empty otherwise." .

sup:Column_TABLE_PARTITIONS__LOAD_UNIT a sup:Column ;
    rdfs:label "LOAD_UNIT column of TABLE_PARTITIONS" ;
    sup:columnName "LOAD_UNIT" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR(7)" ;
    rdfs:comment "Displays the load unit for partition: PAGE (when the partition uses page loadable storage), COLUMN (when the partition uses column loadable storage), or DEFAULT." .

sup:Column_TABLE_PARTITIONS__NODE_ID a sup:Column ;
    rdfs:label "NODE_ID column of TABLE_PARTITIONS" ;
    sup:columnName "NODE_ID" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the ID of the partition node." .

sup:Column_TABLE_PARTITIONS__NUMA_NODE_INDEXES a sup:Column ;
    rdfs:label "NUMA_NODE_INDEXES column of TABLE_PARTITIONS" ;
    sup:columnName "NUMA_NODE_INDEXES" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "NVARCHAR (1024)" ;
    rdfs:comment "Displays a comma-separated list of user-specified logical NUMA node indexes for the table partition. The elements of the list are either individual nodes indexes or ranges of index nodes, or a mixture of both. For example, the value ***0, 1 TO 3, 6*** indicates node indexes 0, 1, 2, 3, and 6." .

sup:Column_TABLE_PARTITIONS__PARENT_NODE_ID a sup:Column ;
    rdfs:label "PARENT_NODE_ID column of TABLE_PARTITIONS" ;
    sup:columnName "PARENT_NODE_ID" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Displays the ID of the parent node." .

sup:Column_TABLE_PARTITIONS__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of TABLE_PARTITIONS" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_TABLE_PARTITIONS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Returns the table partition ID: - For partitioned tables, the part ID is equal to the sequential number of the partition, starting at 1. - For replicated tables, the part ID is 1 for the original table and subsequent part IDs are assigned to replica tables. - The part ID is 0 for tables that are not partitioned. - The part ID is NULL if the row describes the partitioning of a higher level node in multi-level heterogeneous partitioning that has child nodes. - A part ID value of -1 indicates that a modification of the table schema is currently in progress." .

