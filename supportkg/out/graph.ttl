    rdfs:comment "Displays the sum of the MEMORY_SIZE_IN_MAIN and MEMORY_SIZE_IN_DELTA columns in bytes." .

sup:Column_M_CS_ALL_COLUMNS__NUMA_NODE_INDEX a sup:Column ;
    rdfs:label "NUMA_NODE_INDEX column of M_CS_ALL_COLUMNS" ;
    sup:columnName "NUMA_NODE_INDEX" ;
    sup:columnOf sup:View_M_CS_ALL_COLUMNS ;
    sup:dataType "SMALLINT" ;
    rdfs:comment "Displays the NUMA node index where allocations are performed and columns are loaded." .

sup:Column_M_CS_ALL_COLUMNS__PART_ID a sup:Column ;
    rdfs:label "PART_ID column of M_CS_ALL_COLUMNS" ;
    sup:columnName "PART_ID" ;
    sup:columnOf sup:View_M_CS_ALL_COLUMNS ;
    sup:dataType "INTEGER" ;
    rdfs:comment "Returns the table partition ID: - For partitioned tables, the part ID is equal to the sequential number of the partition, starting at 1. - For replicated tables, the part ID is 1 for the original table, and subsequent part IDs are assigned to replica tables. - The part ID is 0 for tables that are not partitioned. - The part ID -1 indicates that the table schema is being modified." .

sup:Column_M_CS_ALL_COLUMNS__PERSISTENT_MEMORY a sup:Column ;
    rdfs:label "PERSISTENT_MEMORY column of M_CS_ALL_COLUMNS" ;
