sup:Column_TABLE_COLUMNS__COMPRESSION_TYPE a sup:Column ;
    rdfs:label "COMPRESSION_TYPE column of TABLE_COLUMNS" ;
    sup:columnName "COMPRESSION_TYPE" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(9)" ;
    rdfs:comment "Indicates the type of compression: DEFAULT, PREFIXED, SPARSE, CLUSTERED, SPARSE, CLUSTERED, INDIRECT, RLE, and LINEAR RLE. The default value for the column is shown. The actual value can be checked in the system view M_ CS_COLUMNS. For row store columns, NONE is shown." .

sup:Column_TABLE_COLUMNS__DATA_TYPE_ID a sup:Column ;
    rdfs:label "DATA_TYPE_ID column of TABLE_COLUMNS" ;
    sup:columnName "DATA_TYPE_ID" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "SMALLINT" ;
    rdfs:comment "Displays the SQL data type ID of the column." .

sup:Column_TABLE_COLUMNS__DATA_TYPE_NAME a sup:Column ;
    rdfs:label "DATA_TYPE_NAME column of TABLE_COLUMNS" ;
    sup:columnName "DATA_TYPE_NAME" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
    sup:dataType "NVARCHAR(16)" ;
    rdfs:comment "Displays the SQL data type name of the column." .

sup:Column_TABLE_COLUMNS__DDIC_DATA_TYPE_ID a sup:Column ;
    rdfs:label "DDIC_DATA_TYPE_ID column of TABLE_COLUMNS" ;
    sup:columnName "DDIC_DATA_TYPE_ID" ;
    sup:columnOf sup:View_TABLE_COLUMNS ;
